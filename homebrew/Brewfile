# Package selections live in config/packages.list, shared with the Linux installer.
# Keep this adapter: `brew bundle dump --force` would overwrite it.
File.foreach(File.expand_path("../config/packages.list", __dir__)) do |line|
  platforms, provider, package, option = line.split
  next if platforms.nil? || platforms.start_with?("#")
  next unless platforms.split(",").include?("darwin")

  case provider
  when "tap"
    option == "trusted" ? tap(package, trusted: true) : tap(package)
  when "brew"
    option == "unlinked" ? brew(package, link: false) : brew(package)
  when "cask"
    cask package
  when "uv"
    uv package
  end
end
