lfs brew pyright
lfs brew ripgrep rg
lfs brew rsync
lfs brew rtk
lfs brew ruff
lfs brew shellcheck
lfs brew tmux
lfs brew trash-cli trash-put
lfs brew tree
lfs brew tree-sitter-cli tree-sitter
