# LFS: skip direct formula requests when the command exists in host paths.
# Keep these rows separate: their optional fourth field is a command probe,
# not a macOS Bundle option. Homebrew still owns transitive dependencies.
lfs brew aria2 aria2c
lfs brew autoconf
lfs brew automake
lfs brew bash
lfs brew bat
lfs brew btop
lfs brew cmake
lfs brew curl
lfs brew fastfetch
