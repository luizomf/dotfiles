#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -n "${OM_PATHS_FILE:-}" || -z "${PROJECTS_DIR:-}" ]]; then
  # shellcheck source=/dev/null
  source "${OM_PATHS_FILE:-${script_dir}/../config/paths.sh}"
fi
export PROJECTS_DIR
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_NO_INDEX=1
export UV_OFFLINE=1
export UV_NO_SYNC=1

(
cd "${PROJECTS_DIR}/omnivoicetts" || exit 1
# TEXT="$(cat | tr '\n' ' ')"
TEXT="$(cat)"
# ./scripts/clear_cache
# pkill -9 -f '[o]mnivoicetts' || true
cat | ./scripts/female-en \
  --offline --player auto \
  --num-step 16 --guidance-scale 2 --t-shift 0.1 \
  --class-temperature 0 --position-temperature 5.0 --layer-penalty-factor 5.0 \
  --chunk-len 180 --prebuffer-chunks 1 --sliding-window-chunks 1 \
  --inter-chunk-silence-ms 50 --chunking kokoro \
  --split-on-newlines True --ensure-terminal-punctuation True \
  --speed 1 --model-fade-ms 200 --model-pad-ms 200 \
  --denoise False --preprocess-prompt False --postprocess-output False \
  --chunk-cache-dir .cache/omnivoice-play/hal \
  --ref-audio samples/hal.wav --language en \
  --instruct "male, middle-aged, moderate pitch, british accent" \
  "$@" > /tmp/voicept.log 2>&1 <<< "$TEXT"
)

