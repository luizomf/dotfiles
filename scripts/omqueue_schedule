#!/usr/bin/env bash

# Functional prototype for viewing Schedules and what they will run.
# Keep as workflow evidence until a supported OMQueue interface replaces it.

# OTAVIO'S NOTES
# One inspection per displayed Schedule is still required to show its opaque
# command because schedule list deliberately excludes Trigger input. Server-side
# filters reduce the candidate set but cannot remove that N+1 query.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omqueue_schedule [--limit <count>] [--status <status[,status...]>]
                        [--label <label>]

Status defaults to enabled,disabled. Results are newest first. Filters are
exact and may be combined; use --status completed for fired one-time Schedules.
EOF
}

limit=10
status="enabled,disabled"
label=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit)
      if [[ $# -lt 2 || ! "$2" =~ ^[1-9][0-9]*$ || "$2" -gt 200 ]]; then
        usage >&2
        exit 2
      fi
      limit="$2"
      shift 2
      ;;
    --status)
      if [[ $# -lt 2 || -z "$2" ]]; then
        usage >&2
        exit 2
      fi
      status="$2"
      shift 2
      ;;
    --label)
      if [[ $# -lt 2 || -z "$2" ]]; then
        usage >&2
        exit 2
      fi
      label="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

schedule_rows_file="$(mktemp)"
schedule_ids_file="$(mktemp)"
schedules_file="$(mktemp)"
readonly schedule_rows_file schedule_ids_file schedules_file

cleanup() {
  rm -f "$schedule_rows_file" "$schedule_ids_file" "$schedules_file"
}
trap cleanup EXIT

cursor=""
while true; do
  list_arguments=(schedule list --limit 200 --status "$status" --json)
  if [[ -n "$label" ]]; then
    list_arguments+=(--label "$label")
  fi
  if [[ -n "$cursor" ]]; then
    list_arguments+=(--cursor "$cursor")
  fi

  page="$(omqueue "${list_arguments[@]}")"
  jq -c '.schedules[]' <<<"$page" >>"$schedule_rows_file"

  if [[ "$(jq -r '.hasMore' <<<"$page")" != "true" ]]; then
    break
  fi
  cursor="$(jq -r '.nextCursor // empty' <<<"$page")"
  if [[ -z "$cursor" ]]; then
    printf 'omqueue_schedule: Queue returned hasMore without nextCursor\n' >&2
    exit 1
  fi
done

jq -sr --argjson limit "$limit" '
  sort_by([(.at // .createdAt // ""), .scheduleId]) |
  reverse |
  .[:$limit][].scheduleId
' "$schedule_rows_file" >"$schedule_ids_file"

while IFS= read -r schedule_id; do
  [[ -n "$schedule_id" ]] || continue
  omqueue schedule inspect "$schedule_id" --json >>"$schedules_file"
  printf '\n' >>"$schedules_file"
done <"$schedule_ids_file"

{
  printf 'SCHEDULE ID\tNAME\tSTATUS\tWHEN\tCOMMAND\n'

  jq -sr --argjson limit "$limit" '
  def bounded($width):
    gsub("[\\t\\r\\n]"; " ") |
    if length > $width then .[0:($width - 3)] + "..." else . end;
  def name:
    if .label == null then "(unnamed)"
    else (.label | tojson | bounded(40))
    end;
  def command:
    if (.triggerInput | type) == "object" and
       (.triggerInput.executable | type) == "string"
    then
      ([.triggerInput.executable] +
       (if (.triggerInput.arguments | type) == "array"
        then .triggerInput.arguments
        else []
        end)) |
      map(tojson) |
      join(" ")
    else
      "Definition " + .definitionId
    end;
  def timing:
    if .at then .at
    else "cron " + .cron + " [" + .timeZone + "]"
    end;

  map(.schedule) |
  sort_by([(.at // .createdAt // ""), .scheduleId]) |
  reverse |
  .[:$limit][] |
  [.scheduleId, name, .status, timing, (command | bounded(100))] |
  @tsv
' "$schedules_file"
} | column -t -s $'\t'
