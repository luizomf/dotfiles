#!/usr/bin/env python3
# Copyright (c) 2026 Luiz Otávio Miranda

"""Submit work to OMQueue or a non-durable local background fallback."""

import fcntl
import json
import math
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import uuid
from collections.abc import Generator, Mapping
from contextlib import contextmanager, suppress
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import NoReturn, TextIO, TypedDict, TypeGuard
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

CONFIG_PATH = Path.home() / ".config" / "bq" / "config.json"
CONFIG_LOCK_PATH = CONFIG_PATH.with_name("config.lock")
OMQUEUE = os.environ.get("BQ_OMQUEUE", "omqueue")
INTERNAL_RUN = "--internal-run"
INTERNAL_LOCAL_RUN = "--internal-local-run"
FORWARDED_OLLAMA_ENVIRONMENT = (
  "OLLAMA_HOST",
  "OLLAMA_TIMEOUT_MS",
  "OLLAMA_LOAD_TIMEOUT",
  "OLLAMA_KEEP_ALIVE",
)


class Config(TypedDict):
  definitionId: str
  concurrencyDefinitions: dict[str, str]


class OptionalInternalRunInput(TypedDict, total=False):
  stdin: str
  ollamaEnvironment: dict[str, str]


class InternalRunInput(OptionalInternalRunInput):
  executable: str
  arguments: list[str]
  workingDirectory: str


LOCAL_BACKGROUND_ENVIRONMENT_KEYS = (
  "HOME",
  "LANG",
  "LC_ALL",
  "LC_CTYPE",
  "LOGNAME",
  "PATH",
  "SHELL",
  "TMPDIR",
  "TZ",
  "USER",
  "XDG_CONFIG_HOME",
  "XDG_RUNTIME_DIR",
  "XDG_STATE_HOME",
)


def fail(message: str, status: int = 1) -> NoReturn:
  print(f"bq: {message}", file=sys.stderr)
  raise SystemExit(status)


def is_object_dict(value: object) -> TypeGuard[dict[object, object]]:
  return isinstance(value, dict)


def is_object_list(value: object) -> TypeGuard[list[object]]:
  return isinstance(value, list)


def is_string_list(value: object) -> TypeGuard[list[str]]:
  return is_object_list(value) and all(isinstance(item, str) for item in value)


def usage(stream: TextIO = sys.stdout) -> None:
  print(
    "Usage:\n"
    "  bq --setup\n"
    "  bq [--cwd DIR] [--concurrency-key KEY] [--label LABEL] [--stdin]"
    " [--json] [--] EXECUTABLE [ARGUMENTS...]\n"
    "  bq [--cwd DIR] [--concurrency-key KEY] [--label LABEL] [--stdin]"
    " --in DURATION [--every DURATION --count N] -- EXECUTABLE [ARGUMENTS...]\n"
    "  bq [--cwd DIR] [--concurrency-key KEY] [--label LABEL] [--stdin]"
    " --at DATETIME [--every DURATION --count N] -- EXECUTABLE [ARGUMENTS...]\n"
    "  bq [--cwd DIR] [--concurrency-key KEY] [--label LABEL] [--stdin]"
    " --cron EXPRESSION [--tz IANA_ZONE] -- EXECUTABLE [ARGUMENTS...]\n"
    """
Backend:
  A configured bq installation uses OMQueue exactly as before. Without
  ~/.config/bq/config.json, bq starts one non-durable local background process.
  The local fallback supports immediate execution, --in, and --at only.

Run now:
  With no timing option, submit one Trigger or local process and return after
  acceptance.

Schedule:
  --in DURATION     Run once after a strict duration such as 10m, 2h, or 1d.
  --at DATETIME     Run once at an ISO 8601 minute with Z or a numeric offset.
  --cron EXPRESSION Run on a numeric five-field cron expression.
  --tz IANA_ZONE    Cron time zone; defaults to the system IANA time zone.
  --every DURATION  Repeat a one-time --in or --at command at this interval.
  --count N         Total one-time runs, from 2 through 100.

Timing rules:
  OMQueue and local one-time timing have one-minute precision. Relative targets
  are rounded up to the next whole minute so they never run early; 1d means
  exactly 24 hours.
  One-time runs use fire_once after downtime. Finite repetition creates N
  independent durable one-time Schedules; cron uses one recurring Schedule.
  The foreground wrapper never sleeps. A local fallback process may wait until
  its one requested --in or --at instant.

Execution:
  --cwd DIR             Capture DIR instead of the current working directory.
  --concurrency-key KEY Serialize Queue work that uses the same non-empty key.
  --label LABEL         Add an optional Queue presentation name.
  --stdin               Persist redirected UTF-8 stdin and restore it for the command.
  --json                Print immediate acceptance as one JSON document.
  --                    Separate bq options from the executable and its arguments.

  With OMQueue, content submitted with --stdin becomes durable Queue data.
  Do not use it for secrets. The local fallback keeps stdin only in the
  background process. Interactive terminal input and binary input are not
  supported.

  Omitting --concurrency-key preserves normal concurrent execution. With
  OMQueue, each key lazily provisions one reusable Job Definition. The local
  fallback accepts the option for compatibility but does not serialize work.

  With OMQueue, Labels are preserved exactly, are not identities, and do not
  affect execution. A finite repetition applies the same Label to each Schedule.

  Commands use literal argument vectors without shell evaluation or wholesale
  inheritance of the submitting shell environment. Personal scripts, common
  Homebrew locations, and system commands are on PATH; PROJECTS_DIR is exported
  separately. On Linux, a valid private per-user runtime and its D-Bus socket
  are discovered at execution time for desktop services such as audio. On macOS,
  commands receive application scheduling policy like an interactive terminal
  command.

Examples:
  bq ./script --flag value
  bq --label 'daily report' --cwd ~/project -- ./script --flag value
  printf '%s' 'literal text' | bq --stdin --json -- ./text-reader
  bq --concurrency-key audio-playback -- cliplay -l a -t "Hello"
  bq --in 15m -- commit
  bq --at '2026-07-28T09:00:00-03:00' -- ./daily-task
  bq --in 1h --every 30m --count 4 -- ./reminder
  bq --cron '0 9 * * 1-5' --tz America/Sao_Paulo -- ./weekday-task""",
    file=stream,
  )


def run_omqueue(
  arguments: list[str], *, capture: bool = False
) -> subprocess.CompletedProcess[str]:
  executable = shutil.which(OMQUEUE)
  if not executable:
    fail(f"OMQueue CLI not found: {OMQUEUE}")

  # OMQUEUE intentionally selects an executable, but argv is literal and shell-free.
  return subprocess.run(  # noqa: S603
    [executable, *arguments],
    check=False,
    text=True,
    capture_output=capture,
  )


def linux_session_environment(runtime_path: Path, user_id: int) -> dict[str, str]:
  try:
    runtime_metadata = runtime_path.lstat()
  except OSError:
    return {}

  if not (
    stat.S_ISDIR(runtime_metadata.st_mode)
    and runtime_metadata.st_uid == user_id
    and stat.S_IMODE(runtime_metadata.st_mode) == PRIVATE_RUNTIME_MODE
  ):
    return {}

  environment = {"XDG_RUNTIME_DIR": str(runtime_path)}
  bus_path = runtime_path / "bus"
  try:
    bus_metadata = bus_path.lstat()
  except OSError:
    return environment
  if stat.S_ISSOCK(bus_metadata.st_mode) and bus_metadata.st_uid == user_id:
    environment["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus_path}"
  return environment


def write_json_document(value: object) -> str:
  with tempfile.NamedTemporaryFile(
    mode="w", encoding="utf-8", prefix="bq-", suffix=".json", delete=False
  ) as handle:
    json.dump(value, handle, ensure_ascii=False, separators=(",", ":"))
    handle.write("\n")
    return handle.name


def queue_configuration_present() -> bool:
  try:
    CONFIG_PATH.lstat()
  except FileNotFoundError:
    return False
  except OSError as error:
    fail(f"cannot inspect configuration {CONFIG_PATH}: {error}")
  return True


def load_config() -> Config:
  try:
    config_value: object = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
  except (OSError, json.JSONDecodeError, TypeError):
    fail(f"not configured; run 'bq --setup' (expected {CONFIG_PATH})")

  if not is_object_dict(config_value):
    fail(f"invalid configuration in {CONFIG_PATH}")

  definition_id = config_value.get("definitionId")
  if not isinstance(definition_id, str) or not definition_id:
    fail(f"invalid Definition identity in {CONFIG_PATH}")

  concurrency_value = config_value.get("concurrencyDefinitions", {})
  if not is_object_dict(concurrency_value):
    fail(f"invalid concurrency Definition mapping in {CONFIG_PATH}")
  concurrency_definitions: dict[str, str] = {}
  for key, value in concurrency_value.items():
    if not isinstance(key, str) or not key or not isinstance(value, str) or not value:
      fail(f"invalid concurrency Definition mapping in {CONFIG_PATH}")
    concurrency_definitions[key] = value

  return {
    "definitionId": definition_id,
    "concurrencyDefinitions": concurrency_definitions,
  }


def load_definition_id() -> str:
  return str(load_config()["definitionId"])


def save_config(config: Config) -> None:
  CONFIG_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
  temporary = CONFIG_PATH.with_suffix(f".{os.getpid()}.tmp")
  temporary.write_text(
    json.dumps(config, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
  )
  temporary.chmod(0o600)
  temporary.replace(CONFIG_PATH)


@contextmanager
def config_lock() -> Generator[None, None, None]:
  CONFIG_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
  descriptor = os.open(CONFIG_LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
  try:
    os.fchmod(descriptor, 0o600)
    fcntl.flock(descriptor, fcntl.LOCK_EX)
    yield
  finally:
    fcntl.flock(descriptor, fcntl.LOCK_UN)
    os.close(descriptor)


def definition_document(
  concurrency_key: str | None = None,
) -> dict[str, object]:
  script_path = str(Path(__file__).resolve())
  document: dict[str, object] = {
    "command": {
      "executable": script_path,
      "arguments": [INTERNAL_RUN],
      "workingDirectory": str(Path.home()),
    },
    "triggerInputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "executable": {"type": "string", "minLength": 1, "pattern": "^/"},
        "arguments": {
          "type": "array",
          "items": {"type": "string"},
        },
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
        },
        "stdin": {"type": "string"},
        "ollamaEnvironment": {
          "type": "object",
          "properties": {
            name: {"type": "string", "minLength": 1}
            for name in FORWARDED_OLLAMA_ENVIRONMENT
          },
          "additionalProperties": False,
        },
      },
      "required": ["executable", "arguments", "workingDirectory"],
      "additionalProperties": False,
    },
    "resourceLimits": {
      "triggerInputBytes": 1048576,
      "attemptOutputBytes": 67108864,
      "resultArtifactBytes": 16777216,
    },
    "retryPolicy": {"maxAttempts": 1},
  }
  if concurrency_key is not None:
    document["concurrencyKey"] = concurrency_key
  return document


def current_definition_revision(definition_id: str) -> int:
  result = run_omqueue(["definition", "inspect", definition_id, "--json"], capture=True)
  if result.returncode != 0:
    sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)
  try:
    revision = json.loads(result.stdout)["definition"]["currentRevision"]
  except (json.JSONDecodeError, KeyError, TypeError):
    fail("OMQueue returned an invalid Definition inspection")
  if not isinstance(revision, int) or isinstance(revision, bool) or revision < 1:
    fail("OMQueue returned an invalid Definition revision")
  return revision


def apply_definition(
  existing_definition_id: str | None,
  concurrency_key: str | None = None,
) -> str:
  document = definition_document(concurrency_key)
  if existing_definition_id is not None:
    document["definitionId"] = existing_definition_id
    document["baseRevision"] = current_definition_revision(existing_definition_id)

  document_path = write_json_document(document)
  try:
    result = run_omqueue(["definition", "apply", document_path, "--json"], capture=True)
  finally:
    Path(document_path).unlink()

  if result.returncode != 0:
    sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)
  try:
    definition_id = json.loads(result.stdout)["result"]["definitionId"]
  except (json.JSONDecodeError, KeyError, TypeError):
    fail("OMQueue returned an invalid Definition response")
  if not isinstance(definition_id, str) or not definition_id:
    fail("OMQueue returned an invalid Definition identity")
  if existing_definition_id is not None and definition_id != existing_definition_id:
    fail("OMQueue returned a different Definition identity")

  return definition_id


def enable_definition(definition_id: str) -> None:
  enabled = run_omqueue(["definition", "enable", definition_id, "--json"], capture=True)
  if enabled.returncode != 0:
    sys.stderr.write(enabled.stderr)
    raise SystemExit(enabled.returncode)


def setup() -> None:
  with config_lock():
    if queue_configuration_present():
      config = load_config()
      existing_definition_id: str | None = config["definitionId"]
      concurrency_definitions = config["concurrencyDefinitions"]
    else:
      existing_definition_id = None
      concurrency_definitions = {}

    definition_id = apply_definition(existing_definition_id)
    reconciled_definitions = {
      key: apply_definition(value, key)
      for key, value in sorted(concurrency_definitions.items())
    }
    save_config(
      {
        "definitionId": definition_id,
        "concurrencyDefinitions": reconciled_definitions,
      }
    )
    enable_definition(definition_id)
    for concurrency_definition_id in reconciled_definitions.values():
      enable_definition(concurrency_definition_id)
  print(f"bq: ready (Definition {definition_id})")


def definition_for_concurrency_key(
  concurrency_key: str | None, *, diagnostics_to_stderr: bool = False
) -> str:
  if concurrency_key is None:
    return load_definition_id()

  with config_lock():
    config = load_config()
    concurrency_definitions = config["concurrencyDefinitions"]
    existing = concurrency_definitions.get(concurrency_key)
    if existing is not None:
      return existing

    definition_id = apply_definition(None, concurrency_key)
    concurrency_definitions[concurrency_key] = definition_id
    save_config(config)
    enable_definition(definition_id)
    print(
      f"bq: ready concurrency key {concurrency_key!r} (Definition {definition_id})",
      file=sys.stderr if diagnostics_to_stderr else sys.stdout,
    )
    return definition_id


def resolve_directory(value: str) -> str:
  directory = Path(value).expanduser().resolve()
  if not directory.is_dir():
    fail(f"working directory does not exist: {value}", 2)
  return str(directory)


def resolve_executable(value: str, working_directory: str) -> str:
  if os.sep in value:
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
      candidate = Path(working_directory) / candidate
    # Preserve symlink paths so the submitted command matches the caller's spelling.
    executable = os.path.abspath(candidate)  # noqa: PTH100
  else:
    executable = shutil.which(value) or ""

  if (
    not executable
    or not Path(executable).is_file()
    or not os.access(executable, os.X_OK)
  ):
    fail(f"executable not found or not executable: {value}", 2)
  return executable


DURATION_PATTERN = re.compile(r"^([1-9][0-9]*)([mhd])$")
ISO_OFFSET_PATTERN = re.compile(r"(?:Z|[+-][0-9]{2}:[0-9]{2})$")
MIN_FINITE_RUNS = 2
MAX_FINITE_RUNS = 100
PRIVATE_RUNTIME_MODE = 0o700
INTERNAL_LOCAL_ARGUMENT_COUNT = 2


def parse_duration(value: str, option: str) -> timedelta:
  match = DURATION_PATTERN.fullmatch(value)
  if match is None:
    fail(f"{option} requires a duration such as 10m, 2h, or 1d", 2)
  amount = int(match.group(1))
  unit = match.group(2)
  try:
    if unit == "m":
      return timedelta(minutes=amount)
    if unit == "h":
      return timedelta(hours=amount)
    return timedelta(days=amount)
  except OverflowError:
    fail(f"{option} duration is too large", 2)


def parse_instant(value: str) -> datetime:
  if ISO_OFFSET_PATTERN.search(value) is None:
    fail("--at requires ISO 8601 with Z or a numeric UTC offset", 2)
  try:
    instant = datetime.fromisoformat(value.replace("Z", "+00:00"))
  except ValueError:
    fail("--at requires a valid ISO 8601 date-time", 2)
  if instant.tzinfo is None:
    fail("--at requires an explicit UTC offset", 2)
  if instant.second != 0 or instant.microsecond != 0:
    fail("--at must be aligned to a whole minute", 2)
  try:
    return instant.astimezone(timezone.utc)
  except (OverflowError, ValueError):
    fail("--at offset produces an out-of-range UTC date", 2)


def ceil_to_minute(instant: datetime) -> datetime:
  if instant.second == 0 and instant.microsecond == 0:
    return instant
  return instant.replace(second=0, microsecond=0) + timedelta(minutes=1)


def format_instant(instant: datetime) -> str:
  return instant.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:00Z")


def valid_time_zone(candidates: list[str]) -> str | None:
  for candidate in candidates:
    if not candidate or candidate.startswith(":"):
      continue
    if "/" not in candidate and any(character.isdigit() for character in candidate):
      continue
    try:
      ZoneInfo(candidate)
    except (ValueError, ZoneInfoNotFoundError):
      continue
    else:
      return candidate
  return None


def system_time_zone() -> str:
  candidates = [os.environ.get("TZ", "")]
  with suppress(OSError):
    candidates.append(Path("/etc/timezone").read_text(encoding="utf-8").strip())

  try:
    target = str(Path("/etc/localtime").resolve())
  except OSError:
    target = ""
  candidates.extend(
    target.split(marker, 1)[1]
    for marker in ("/zoneinfo/", "/usr/share/zoneinfo/")
    if marker in target
  )

  detected = valid_time_zone(candidates)
  if detected is None:
    fail("cannot detect the system IANA time zone; pass --tz", 2)
  return detected


def option_value(arguments: list[str], index: int, option: str) -> str:
  if index + 1 >= len(arguments):
    fail(f"{option} requires a value", 2)
  return arguments[index + 1]


@dataclass
class SubmissionOptions:
  working_directory: str
  timing: dict[str, object]
  concurrency_key: str | None = None
  label: str | None = None
  label_supplied: bool = False
  capture_stdin: bool = False
  json_output: bool = False


def apply_timing_option(
  timing: dict[str, object],
  arguments: list[str],
  index: int,
) -> int | None:
  option = arguments[index]
  if option in ("--in", "--at", "--cron", "--tz", "--every"):
    timing[option[2:]] = option_value(arguments, index, option)
  elif option == "--count":
    try:
      timing["count"] = int(option_value(arguments, index, option))
    except ValueError:
      fail("--count requires an integer", 2)
  else:
    return None
  return index + 2


def apply_submission_option(
  options: SubmissionOptions,
  arguments: list[str],
  index: int,
) -> int | None:
  option = arguments[index]
  timing_index = apply_timing_option(options.timing, arguments, index)
  if timing_index is not None:
    return timing_index
  if option == "--cwd":
    options.working_directory = resolve_directory(
      option_value(arguments, index, option)
    )
  elif option == "--concurrency-key":
    options.concurrency_key = option_value(arguments, index, option)
    if not options.concurrency_key:
      fail("--concurrency-key requires a non-empty value", 2)
  elif option == "--label":
    if options.label_supplied:
      fail("--label may be supplied only once", 2)
    options.label = option_value(arguments, index, option)
    options.label_supplied = True
  elif option == "--stdin":
    options.capture_stdin = True
    return index + 1
  elif option == "--json":
    options.json_output = True
    return index + 1
  elif option.startswith("--"):
    fail(f"unknown bq option: {option}; use -- before command options", 2)
  else:
    return None
  return index + 2


def scan_submission_options(
  arguments: list[str],
) -> tuple[SubmissionOptions, int]:
  options = SubmissionOptions(working_directory=str(Path.cwd()), timing={})
  index = 0
  while index < len(arguments):
    if arguments[index] == "--":
      index += 1
      break
    next_index = apply_submission_option(options, arguments, index)
    if next_index is None:
      break
    index = next_index
  return options, index


def validate_submission_timing(options: SubmissionOptions) -> None:
  timing = options.timing
  modes = [name for name in ("in", "at", "cron") if name in timing]
  if len(modes) > 1:
    fail("use only one of --in, --at, or --cron", 2)
  if "tz" in timing and "cron" not in timing:
    fail("--tz is valid only with --cron", 2)
  if "cron" in timing and ("every" in timing or "count" in timing):
    fail("--cron cannot be combined with --every or --count", 2)
  if ("every" in timing) != ("count" in timing):
    fail("--every and --count must be used together", 2)
  if "every" in timing and not any(name in timing for name in ("in", "at")):
    fail("--every requires --in or --at", 2)
  if "count" in timing:
    count = timing["count"]
    if not isinstance(count, int) or not MIN_FINITE_RUNS <= count <= MAX_FINITE_RUNS:
      fail(
        f"--count must be from {MIN_FINITE_RUNS} through {MAX_FINITE_RUNS}",
        2,
      )
  if options.json_output and timing:
    fail("--json is supported only for immediate submissions", 2)


def capture_submission_input() -> str:
  if sys.stdin.isatty():
    fail("--stdin requires piped or redirected UTF-8 input", 2)
  try:
    return sys.stdin.buffer.read().decode("utf-8")
  except UnicodeDecodeError:
    fail("--stdin input is not valid UTF-8", 2)


def parse_submission(
  arguments: list[str],
) -> tuple[dict[str, object], dict[str, object], str | None, str | None, bool]:
  options, executable_index = scan_submission_options(arguments)
  if executable_index >= len(arguments):
    usage(sys.stderr)
    fail("missing executable", 2)
  validate_submission_timing(options)

  executable = resolve_executable(
    arguments[executable_index], options.working_directory
  )
  trigger_input: dict[str, object] = {
    "executable": executable,
    "arguments": arguments[executable_index + 1 :],
    "workingDirectory": str(Path(options.working_directory).resolve()),
    "ollamaEnvironment": {
      name: value
      for name in FORWARDED_OLLAMA_ENVIRONMENT
      if (value := os.environ.get(name))
    },
  }
  if options.capture_stdin:
    trigger_input["stdin"] = capture_submission_input()
  return (
    trigger_input,
    options.timing,
    options.concurrency_key,
    options.label,
    options.json_output,
  )


def submit_now(
  trigger_input: dict[str, object],
  definition_id: str,
  label: str | None,
  *,
  json_output: bool = False,
) -> None:
  document_path = write_json_document(trigger_input)
  try:
    arguments = [
      "trigger",
      definition_id,
      document_path,
      "--idempotency-key",
      f"bq-{uuid.uuid4()}",
    ]
    if label is not None:
      arguments.extend(["--label", label])
    arguments.append("--json")
    result = run_omqueue(arguments, capture=True)
  finally:
    Path(document_path).unlink()

  if result.returncode != 0:
    sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)
  try:
    job = json.loads(result.stdout)["job"]
    job_id = job["jobId"]
    state = job["state"]
  except (json.JSONDecodeError, KeyError, TypeError):
    fail("OMQueue returned an invalid Trigger response")
  if not isinstance(job_id, str) or not job_id or not isinstance(state, str):
    fail("OMQueue returned an invalid Trigger response")
  if json_output:
    print(json.dumps({"jobId": job_id, "state": state}, separators=(",", ":")))
  else:
    print(f"bq: accepted Job {job_id} ({state})")


def create_schedule(document: dict[str, object]) -> str:
  document_path = write_json_document(document)
  try:
    applied = run_omqueue(["schedule", "apply", document_path, "--json"], capture=True)
  finally:
    Path(document_path).unlink()

  if applied.returncode != 0:
    sys.stderr.write(applied.stderr)
    raise SystemExit(applied.returncode)
  try:
    schedule_id = json.loads(applied.stdout)["result"]["scheduleId"]
  except (json.JSONDecodeError, KeyError, TypeError):
    fail("OMQueue returned an invalid Schedule response")
  if not isinstance(schedule_id, str) or not schedule_id:
    fail("OMQueue returned an invalid Schedule identity")

  enabled = run_omqueue(["schedule", "enable", schedule_id, "--json"], capture=True)
  if enabled.returncode != 0:
    print(
      f"bq: Schedule {schedule_id} was created but could not be enabled",
      file=sys.stderr,
    )
    sys.stderr.write(enabled.stderr)
    raise SystemExit(enabled.returncode)
  return schedule_id


def schedule_cron_submission(
  trigger_input: dict[str, object],
  timing: dict[str, object],
  definition_id: str,
  label: str | None,
) -> None:
  cron = timing["cron"]
  time_zone = timing.get("tz") or system_time_zone()
  document: dict[str, object] = {
    "definitionId": definition_id,
    "triggerInput": trigger_input,
    "timeZone": time_zone,
    "cron": cron,
    "latePolicy": "fire_once",
  }
  if label is not None:
    document["label"] = label
  schedule_id = create_schedule(document)
  print(f"bq: scheduled {schedule_id} cron={cron!r} timeZone={time_zone}")


def first_schedule_instant(timing: dict[str, object]) -> datetime:
  if "in" not in timing:
    return parse_instant(str(timing["at"]))
  delay = parse_duration(str(timing["in"]), "--in")
  try:
    return ceil_to_minute(datetime.now(timezone.utc) + delay)
  except OverflowError:
    fail("--in duration produces an out-of-range date", 2)


def schedule_instants(timing: dict[str, object]) -> list[str]:
  first = first_schedule_instant(timing)
  interval = (
    parse_duration(str(timing["every"]), "--every")
    if "every" in timing
    else timedelta(0)
  )
  count = timing.get("count", 1)
  if not isinstance(count, int) or isinstance(count, bool):
    fail("invalid internal repetition count")
  try:
    return [
      format_instant(first + interval * occurrence) for occurrence in range(count)
    ]
  except (OverflowError, ValueError):
    fail("repetition produces an out-of-range date", 2)


def schedule_submission(
  trigger_input: dict[str, object],
  timing: dict[str, object],
  definition_id: str,
  label: str | None,
) -> None:
  if "cron" in timing:
    schedule_cron_submission(trigger_input, timing, definition_id, label)
    return

  instants = schedule_instants(timing)
  count = len(instants)
  scheduled: list[tuple[str, str]] = []
  for occurrence, at in enumerate(instants):
    document: dict[str, object] = {
      "definitionId": definition_id,
      "triggerInput": trigger_input,
      "timeZone": "UTC",
      "at": at,
      "latePolicy": "fire_once",
    }
    if label is not None:
      document["label"] = label
    schedule_id = create_schedule(document)
    scheduled.append((schedule_id, at))
    if count > 1:
      print(f"bq: scheduled {occurrence + 1}/{count} at={at} {schedule_id}")

  if len(scheduled) == 1:
    schedule_id, at = scheduled[0]
    print(f"bq: scheduled {schedule_id} at={at}")
  else:
    print(f"bq: scheduled all {len(scheduled)} one-time runs")


def local_due_instant(
  timing: dict[str, object], *, now: datetime | None = None
) -> datetime:
  unsupported = [name for name in ("cron", "every", "count", "tz") if name in timing]
  if unsupported:
    options = ", ".join(f"--{name}" for name in unsupported)
    fail(
      f"local background fallback does not support {options}; "
      "run 'bq --setup' to use OMQueue scheduling",
      2,
    )

  current = now or datetime.now(timezone.utc)
  if "in" in timing:
    delay = parse_duration(str(timing["in"]), "--in")
    try:
      return ceil_to_minute(current + delay)
    except OverflowError:
      fail("--in duration produces an out-of-range date", 2)
  if "at" in timing:
    return parse_instant(str(timing["at"]))
  return current


def local_background_environment(source: Mapping[str, str]) -> dict[str, str]:
  return {
    name: value
    for name in LOCAL_BACKGROUND_ENVIRONMENT_KEYS
    if (value := source.get(name)) is not None
  }


def submit_local_background(
  trigger_input: dict[str, object],
  timing: dict[str, object],
  concurrency_key: str | None,
  *,
  json_output: bool,
) -> None:
  due = local_due_instant(timing)
  working_directory = str(trigger_input["workingDirectory"])
  command = [
    sys.executable,
    str(Path(__file__).resolve()),
    INTERNAL_LOCAL_RUN,
    str(due.timestamp()),
  ]

  with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as trigger_file:
    json.dump(trigger_input, trigger_file, ensure_ascii=False, separators=(",", ":"))
    trigger_file.write("\n")
    trigger_file.flush()
    trigger_file.seek(0)
    try:
      # Fixed interpreter and repository-owned bq path; input travels over stdin.
      process = subprocess.Popen(  # noqa: S603
        command,
        cwd=working_directory,
        env=local_background_environment(os.environ),
        stdin=trigger_file,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
      )
    except OSError as error:
      fail(f"cannot start local background process: {error}")

  if json_output:
    print(
      json.dumps(
        {
          "mode": "local_background",
          "pid": process.pid,
          "nonDurable": True,
          "concurrencyKeyEnforced": False,
        },
        separators=(",", ":"),
      )
    )
    return

  timing_text = f" at={format_instant(due)}" if timing else ""
  concurrency_text = (
    "; concurrency key not enforced" if concurrency_key is not None else ""
  )
  print(
    f"bq: started local background process pid={process.pid}{timing_text} "
    f"(non-durable{concurrency_text})"
  )


def submit(arguments: list[str]) -> None:
  trigger_input, timing, concurrency_key, label, json_output = parse_submission(
    arguments
  )
  if not queue_configuration_present():
    submit_local_background(
      trigger_input, timing, concurrency_key, json_output=json_output
    )
    return

  definition_id = definition_for_concurrency_key(
    concurrency_key, diagnostics_to_stderr=json_output
  )
  if timing:
    schedule_submission(trigger_input, timing, definition_id, label)
  else:
    submit_now(trigger_input, definition_id, label, json_output=json_output)


def internal_local_run(due_value: str) -> NoReturn:
  try:
    due = float(due_value)
  except ValueError:
    fail("invalid local background instant", 2)
  if not math.isfinite(due):
    fail("invalid local background instant", 2)

  while True:
    remaining = due - time.time()
    if remaining <= 0:
      break
    time.sleep(min(remaining, 60.0))
  internal_run()


def load_internal_run_input() -> InternalRunInput:
  try:
    value: object = json.load(sys.stdin)
  except (json.JSONDecodeError, TypeError) as error:
    fail(f"invalid Trigger input: {error}")

  if not is_object_dict(value):
    fail("invalid Trigger input shape")

  try:
    executable = value["executable"]
    arguments = value["arguments"]
    working_directory = value["workingDirectory"]
  except KeyError as error:
    fail(f"invalid Trigger input: {error}")

  ollama_environment = value.get("ollamaEnvironment", {})
  has_stdin = "stdin" in value
  command_stdin = value.get("stdin")
  if not (
    isinstance(executable, str)
    and executable.startswith("/")
    and is_string_list(arguments)
    and isinstance(working_directory, str)
    and working_directory.startswith("/")
    and is_object_dict(ollama_environment)
    and (not has_stdin or isinstance(command_stdin, str))
  ):
    fail("invalid Trigger input shape")

  validated_environment: dict[str, str] = {}
  for name, environment_value in ollama_environment.items():
    if not (
      isinstance(name, str)
      and name in FORWARDED_OLLAMA_ENVIRONMENT
      and isinstance(environment_value, str)
      and environment_value
    ):
      fail("invalid Trigger input shape")
    validated_environment[name] = environment_value

  trigger_input: InternalRunInput = {
    "executable": executable,
    "arguments": arguments.copy(),
    "workingDirectory": working_directory,
    "ollamaEnvironment": validated_environment,
  }
  if has_stdin and isinstance(command_stdin, str):
    trigger_input["stdin"] = command_stdin
  return trigger_input


def internal_run() -> NoReturn:
  trigger_input = load_internal_run_input()
  executable = trigger_input["executable"]
  arguments = trigger_input["arguments"]
  working_directory = trigger_input["workingDirectory"]
  ollama_environment = trigger_input.get("ollamaEnvironment", {})

  scripts_directory = str(Path(__file__).resolve().parent)
  preferred_path = [
    scripts_directory,
    str(Path.home() / ".local" / "bin"),
    "/opt/homebrew/bin",
    "/opt/homebrew/sbin",
    "/home/linuxbrew/.linuxbrew/bin",
    "/home/linuxbrew/.linuxbrew/sbin",
    "/usr/local/bin",
    "/usr/local/sbin",
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin",
  ]
  os.environ["PATH"] = os.pathsep.join(
    entry for entry in preferred_path if Path(entry).is_dir()
  )
  os.environ["PROJECTS_DIR"] = str(Path.home() / "Desktop" / "tutoriais_e_cursos")
  if sys.platform.startswith("linux"):
    user_id = os.getuid()
    os.environ.update(
      linux_session_environment(Path("/run/user") / str(user_id), user_id)
    )
  os.environ.update(ollama_environment)

  try:
    os.chdir(working_directory)
    if "stdin" in trigger_input:
      with tempfile.TemporaryFile() as stdin_file:
        stdin_file.write(trigger_input["stdin"].encode("utf-8"))
        stdin_file.seek(0)
        os.dup2(stdin_file.fileno(), 0)
    if sys.platform == "darwin":
      taskpolicy = "/usr/sbin/taskpolicy"
      # Literal exec is the command runner's core contract; no shell is involved.
      os.execv(taskpolicy, [taskpolicy, "-a", executable, *arguments])  # noqa: S606
    os.execv(executable, [executable, *arguments])  # noqa: S606
  except OSError as error:
    fail(f"cannot execute {executable}: {error}")


def main() -> None:
  arguments = sys.argv[1:]
  if arguments == [INTERNAL_RUN]:
    internal_run()
  if arguments[:1] == [INTERNAL_LOCAL_RUN]:
    if len(arguments) != INTERNAL_LOCAL_ARGUMENT_COUNT:
      fail(f"{INTERNAL_LOCAL_RUN} requires one internal instant", 2)
    internal_local_run(arguments[1])
  if arguments and arguments[0] == "--setup":
    if arguments != ["--setup"]:
      fail("--setup cannot be combined with other options", 2)
    setup()
    return
  if arguments in (["-h"], ["--help"]):
    usage()
    return
  if not arguments:
    usage(sys.stderr)
    raise SystemExit(2)
  submit(arguments)


if __name__ == "__main__":
  main()
