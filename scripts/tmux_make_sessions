#!/usr/bin/env bash

set -euo pipefail

trap 'echo "Error on line $LINENO"' ERR

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n ${OM_PATHS_FILE:-} || -z ${PROJECTS_DIR:-} ]]; then
  # shellcheck source=../config/paths.sh
  source "${OM_PATHS_FILE:-$script_dir/../config/paths.sh}"
fi

tmux_make_sessions() {
  projects_dir=${1:-${PROJECTS_DIR:-}}
  if [[ ! -d "$projects_dir" ]]; then
    printf 'Not a directory: %s\n' "$projects_dir" >&2
    return 1
  fi
  if tmux has-session 2>/dev/null; then
    echo "Stop the target tmux server when safe before generating an environment." >&2
    return 1
  fi

  echo "Creating the initial environment (shells start now; subsequent restores are lazy)..."

  home_session="HOME"
  home_path="${HOME}"
  other_windows=("term")

  # Directory arguments are literal paths, not tmux format expressions.
  tmux new -s "${home_session}" -d -n code -c "${home_path//#/##}"

  for how in "${other_windows[@]}"; do
    tmux neww -S -a -t "${home_session}" -d -n "${how}" -c "${home_path//#/##}"
  done

  dotfiles_session="dotfiles"
  dotfiles_path="${home_path}/dotfiles"

  tmux new -s "${dotfiles_session}" -d -n code -c "${dotfiles_path//#/##}"

  for dow in "${other_windows[@]}"; do
    tmux neww -S -a -t "${dotfiles_session}" -d -n "${dow}" -c "${dotfiles_path//#/##}"
  done

  find "${projects_dir}/" -mindepth 1 -maxdepth 1 -type d -print0 | while IFS= read -r -d '' dir; do
    dirname=$(basename "${dir}")

    session_name="${dirname//./_}"
    first_window_name="code"

    tmux new -s "${session_name}" -d -n "${first_window_name}" -c "${dir//#/##}"

    for ow in "${other_windows[@]}"; do
      tmux neww -d -S -a -n "${ow}" -t "${session_name}" -c "${dir//#/##}"
    done
  done

  "$script_dir/tmux-lazy" save --quiet

  echo "Done. Now run: 'tmux a'"
}

tmux_make_sessions "${@}"
