#!/usr/bin/env bash

set -euo pipefail

readonly LABEL="omqueue_test_snippet"
readonly CONCURRENCY_KEY="audio-playback"
readonly PROJECTS_DIR="${PROJECTS_DIR:-$HOME/Desktop/tutoriais_e_cursos}"
readonly REPO="$PROJECTS_DIR/edgetts"
MESSAGE="$(cat <<'TEXT'
Attention. This is only a test of the O M Queue distributed emergency audio system. This is not a real emergency. Reports of unidentified objects entering Earth’s atmosphere, extraterrestrial activity, and an imminent alien invasion are entirely fictional. No action is required. Remain calm and continue your normal activities while Otavio Miranda tests synchronized text-to-speech playback across three computers. This concludes the English portion of the test. Atenção. Este é apenas um teste do sistema distribuído de áudio de emergência O M Queue. Esta não é uma emergência real. Relatos de objetos não identificados entrando na atmosfera da Terra, atividade extraterrestre e uma invasão alienígena iminente são inteiramente fictícios. Nenhuma ação é necessária. Mantenha a calma e continue suas atividades normalmente enquanto Luiz Otávio testa a reprodução sincronizada de texto para fala em três computadores. Esta é a conclusão do teste em português.
TEXT
)"
readonly MESSAGE

submit_local() {
  printf %s "$MESSAGE" | "$HOME/dotfiles/scripts/bq" \
    --stdin \
    --label "$LABEL" \
    --json \
    --cwd "$REPO" \
    --concurrency-key "$CONCURRENCY_KEY" \
    -- "$HOME/.local/bin/edgetts"
}

submit_remote() {
  local host="$1"
  printf %s "$MESSAGE" | ssh -o BatchMode=yes "$host" \
    'repo="${PROJECTS_DIR:-$HOME/Desktop/tutoriais_e_cursos}/edgetts"; exec "$HOME/dotfiles/scripts/bq" --stdin --label omqueue_test_snippet --json --cwd "$repo" --concurrency-key audio-playback -- "$HOME/.local/bin/edgetts"'
}

status=0
submit_local || status=1
for host in m4128 fedoraair; do
  submit_remote "$host" || status=1
done
exit "$status"
