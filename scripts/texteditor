#!/usr/bin/env bash

# Resolve relative paths before switching the editor's working directory.
files=()
for file in "$@"; do
  case "$file" in
    /*) files+=("$file") ;;
    *) files+=("$PWD/$file") ;;
  esac
done

cd "${HOME}" || exit 1

# Expand the command in the terminal's shell, not in this launcher.
# shellcheck disable=SC2016
open -na OMXterm --args \
  -e "${SHELL:-/bin/sh}" -lc \
  '
    # Finder does not inherit the terminal environment where NVM loads Node.
    if ! command -v node >/dev/null 2>&1; then
      export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
      if [ -s "$NVM_DIR/nvm.sh" ]; then
        . "$NVM_DIR/nvm.sh"
      fi
    fi
    exec nvim -n -- "$@"
  ' texteditor "${files[@]}"
