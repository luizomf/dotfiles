#!/usr/bin/env bash

set -Eeuo pipefail

report_error() {
  local status="$1" command="$2"
  printf 'tmuxns: ERROR: command failed (exit %s): %s\n' "$status" "$command" >&2
  exit "$status"
}
trap 'report_error "$?" "$BASH_COMMAND"' ERR

tmuxns() {
  if [[ -z "${1:-}" ]]; then
    echo "tmuxns: ERROR: please provide a session name." >&2
    return 1
  fi

  session_name="$1"
  shift

  if [[ -z "${PROJECTS_DIR:-}" ]]; then
    echo "tmuxns: ERROR: PROJECTS_DIR is unset or empty." >&2
    return 1
  fi

  session_dir="${PROJECTS_DIR}/${session_name}"
  mkdir -p "${session_dir}"

  tmux has-session -t "${session_name}" 2>/dev/null || tmux new-session -d -s "${session_name}" -c "${session_dir}" -n "code"

  for arg in "$@"; do
    tmux new-window -t "${session_name}" -n "${arg}" -c "${session_dir}"
  done
}

tmuxns "${@}"

