#!/usr/bin/env bash
#
# keepwarm — pings Codex and Pi on the host and in Sannux persistent homes.
#
# Each environment uses its own login; this script never copies credentials.
# Normal agent calls may refresh OAuth tokens and persist them in that home.
# A successful ping confirms a working request, not that a refresh occurred.
#
# This does not make copied auth safe: sannux_ephemeral can still refresh a
# copied token and discard its replacement. Periodic pings cannot guarantee
# that every ephemeral run finishes before its copied access token expires.

set -uo pipefail

LOG_FILE="$HOME/dotfiles/scripts/keepwarm.log"

INTERVAL="1h"        # Default: 1h  — time between pings
INITIAL_RUN=1        # Default: 1   — 1 = ping once shortly after starting
INITIAL_DELAY="10s"  # Default: 10s — wait before the first ping

# Match older workers, never this launcher or its calling shell. Unlike macOS,
# Linux procps includes ancestors unless explicitly excluded with -A.
if [[ "$(uname -s)" == "Linux" ]]; then
  pkill -A -9 -f "[k]eepwarm" >/dev/null 2>&1 || true
else
  pkill -9 -f "[k]eepwarm" >/dev/null 2>&1 || true
fi

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >> "$LOG_FILE"
}

trap 'log "TERM/INT received, exiting"; exit 0' TERM INT

maybe_sleep() {
  [ -n "${1:-}" ] && sleep "$1"
}

run_ping() {
  # $1 = label for the log; remaining args = the command to pipe the prompt to.
  local label="$1"; shift
  local out err rc errfile
  # Keep stdout (the agent's answer) and stderr (banners, progress, container
  # noise) apart: codex dumps a verbose, ANSI-colored banner on stderr that
  # would otherwise pollute every successful ping. We only want the answer on
  # success, and the diagnostics only when something actually fails.
  errfile="$(mktemp)"
  out="$(echo 'Reply with exactly: Oi. Do not use tools.' | "$@" 2>"$errfile")"
  rc=$?
  err="$(cat "$errfile")"; rm -f "$errfile"

  # A failed ping does NOT kill the loop — just log it and retry next cycle.
  if [ "$rc" -eq 0 ]; then
    log "$label ping ok: $(printf '%s' "$out" | tr '\n' ' ')"
  else
    log "$label ping FAILED (rc=$rc): $(printf '%s' "$err" | tr '\n' ' ')"
  fi
}

ping_agents() {
  # Temporarily disabled while Claude is not needed this month.
  # run_ping claude sannux run \
  #   claude-code -p - --model haiku --effort low --dangerously-skip-permissions
  # sannux run claude-code auth status >/dev/null 2>&1 || true

  # Preserve the maintenance model unless the owner overrides it.
  # Host and container calls resolve credentials from their respective homes.
  run_ping codex-host \
    codex exec --skip-git-repo-check - --ephemeral --model "${KEEPWARM_CODEX_MODEL:-gpt-6-luna}" -c model_reasoning_effort=low --color never

  run_ping pi-host \
    pi -p --no-session --model openai-codex/gpt-6-luna:low

  run_ping codex-sannux sannux run \
    codex exec --skip-git-repo-check - --ephemeral --model "${KEEPWARM_CODEX_MODEL:-gpt-6-luna}" -c model_reasoning_effort=low --color never

  run_ping pi-sannux sannux run \
    pi -p --no-session --model openai-codex/gpt-6-luna:low

  run_ping codex-in-pi sannux compose pi run --rm -T --entrypoint codex agent \
    exec --skip-git-repo-check - --ephemeral --model "${KEEPWARM_CODEX_MODEL:-gpt-6-luna}" -c model_reasoning_effort=low --color never
}

reload_loop() {
  if [ "$INITIAL_RUN" -eq 1 ]; then
    maybe_sleep "$INITIAL_DELAY"

    ping_agents
    sleep 30
    ping_agents
  fi

  while :; do
    maybe_sleep "$INTERVAL"

    ping_agents
    sleep 30
    ping_agents
  done
}

log "keepwarm started (interval=$INTERVAL, initial_run=$INITIAL_RUN, initial_delay=$INITIAL_DELAY)"
reload_loop &
disown
