#!/usr/bin/env bash
#
# keepwarm — one worker pings five independent logins on each fleet host via SSH.
# Run without arguments for the hourly loop, or --once for a foreground check.
#
# Each environment uses its own login; this script never copies credentials.
# Normal agent calls may refresh OAuth tokens and persist them in that home.
# A successful ping confirms a working request, not that a refresh occurred.
#
# This does not make copied auth safe: sannux_ephemeral can still refresh a
# copied token and discard its replacement. Periodic pings cannot guarantee
# that every ephemeral run finishes before its copied access token expires.

set -uo pipefail

LOG_FILE="$HOME/dotfiles/scripts/keepwarm.log"

INTERVAL=3600        # Seconds between ping pairs
INITIAL_RUN=1        # 1 = ping once shortly after starting
INITIAL_DELAY=10     # Seconds before the first ping

hosts=(m132 m4128 fedoraair)
once=0
if (( $# > 1 )); then
  printf 'Usage: %s [--once]\n' "${0##*/}" >&2
  exit 2
fi
case "${1:-}" in
  '') ;;
  --once) once=1 ;;
  -h|--help) printf 'Usage: %s [--once]\n' "${0##*/}"; exit 0 ;;
  *) printf 'Usage: %s [--once]\n' "${0##*/}" >&2; exit 2 ;;
esac

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >> "$LOG_FILE"
  if (( once )); then printf '%s\n' "$1"; fi
}

trap 'log "TERM received, exiting"; exit 143' TERM
trap 'log "INT received, exiting"; exit 130' INT

check_ownership() {
  (( once )) && return
  local current
  if ! read -r current 2>/dev/null < "$STATE_FILE" || [[ "$current" != "$worker_token" ]]; then
    log "worker replaced, exiting"
    exit 0
  fi
}

maybe_sleep() {
  local remaining="$1"
  while (( remaining > 0 )); do
    check_ownership
    sleep 1
    (( remaining -= 1 ))
  done
  check_ownership
}

run_ping() {
  # $1 = label for the log; remaining args = the command to pipe the prompt to.
  local label="$1"; shift
  check_ownership
  local out err rc errfile
  # Keep stdout (the agent's answer) and stderr (banners, progress, container
  # noise) apart: codex dumps a verbose, ANSI-colored banner on stderr that
  # would otherwise pollute every successful ping. We only want the answer on
  # success, and the diagnostics only when something actually fails.
  errfile="$(mktemp)"
  out="$(echo 'Reply with exactly: Oi. Do not use tools.' | "$@" 2>"$errfile")"
  rc=$?
  err="$(cat "$errfile")"; rm -f "$errfile"

  # A failed ping does NOT kill the loop — just log it and retry next cycle.
  if [ "$rc" -eq 0 ]; then
    (( cycle_successes += 1 ))
    log "$label ping ok: $(printf '%s' "$out" | tr '\n' ' ')"
  else
    (( cycle_failures += 1 ))
    log "$label ping FAILED (rc=$rc): $(printf '%s' "$err" | tr '\n' ' ')"
  fi
}

remote_command() {
  local host="$1" command
  shift
  # Each host loads its own PATH and PROJECTS_DIR. Never export caller auth.
  printf -v command '%q ' "$@"
  printf -v command 'zsh -l -i +m -c %q' "$command"
  # Batch mode prevents unattended password prompts. Keep stdin for the ping.
  ssh -T -o BatchMode=yes -o ConnectTimeout=10 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$host" "$command"
}

ping_agents() {
  local host
  cycle_successes=0
  cycle_failures=0
  for host in "${hosts[@]}"; do
    # Preserve the maintenance model unless the owner overrides it.
    run_ping "$host/codex-host" remote_command "$host" \
      codex exec --skip-git-repo-check - --ephemeral --model "${KEEPWARM_CODEX_MODEL:-gpt-6-luna}" -c model_reasoning_effort=low --color never

    run_ping "$host/pi-host" remote_command "$host" \
      pi -p --no-session --model openai-codex/gpt-6-luna:low

    run_ping "$host/codex-sannux" remote_command "$host" sannux run \
      codex exec --skip-git-repo-check - --ephemeral --model "${KEEPWARM_CODEX_MODEL:-gpt-6-luna}" -c model_reasoning_effort=low --color never

    run_ping "$host/pi-sannux" remote_command "$host" sannux run \
      pi -p --no-session --model openai-codex/gpt-6-luna:low

    run_ping "$host/codex-in-pi" remote_command "$host" sannux compose pi run --rm -T --entrypoint codex agent \
      exec --skip-git-repo-check - --ephemeral --model "${KEEPWARM_CODEX_MODEL:-gpt-6-luna}" -c model_reasoning_effort=low --color never
  done
  log "keepwarm round: $cycle_successes successful, $cycle_failures failed."
  (( cycle_failures == 0 ))
}

reload_loop() {
  if [ "$INITIAL_RUN" -eq 1 ]; then
    maybe_sleep "$INITIAL_DELAY"

    ping_agents
    maybe_sleep 30
    ping_agents
  fi

  while :; do
    maybe_sleep "$INTERVAL"

    ping_agents
    maybe_sleep 30
    ping_agents
  done
}

if (( once )); then
  ping_agents
  exit $?
fi

# Publish a unique generation atomically. Workers retire themselves; never
# signal a PID from a stale record or match unrelated process command lines.
# Concurrent launchers are last-publication-wins. Keep the record on exit so
# an older worker cannot erase a newer worker's ownership.
umask 077
state_dir="$HOME/.cache/keepwarm"
STATE_FILE="$state_dir/current"
mkdir -p "$state_dir" || exit 1
[[ ! -d "$STATE_FILE" ]] || exit 1
worker_token="$(mktemp "$state_dir/worker.XXXXXXXXXX")" || exit 1
if ! printf '%s\n' "$worker_token" > "$worker_token" || ! mv -f "$worker_token" "$STATE_FILE"; then
  rm -f "$worker_token"
  exit 1
fi
log "keepwarm started (hosts=${hosts[*]}, interval=$INTERVAL, initial_run=$INITIAL_RUN, initial_delay=$INITIAL_DELAY)"
reload_loop </dev/null >/dev/null 2>&1 &
disown
