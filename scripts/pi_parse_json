#!/usr/bin/env bash

colors=false
if [[ -n "${FORCE_COLOR:-}" || ( -t 1 && -z "${NO_COLOR:-}" ) ]]; then
  colors=true
fi

jq --unbuffered --join-output --argjson colors "$colors" '
  def colorize($code; $text):
    if $colors then
      "\u001b[\($code)m\($text)\u001b[0m"
    else
      $text
    end;

  def token_usage($messages):
    [
      $messages[]?
      | select(.role == "assistant" and .usage != null)
      | .usage
    ] as $usage
    | if ($usage | length) == 0 then
        ""
      else
        ($usage | map(.totalTokens // 0) | add) as $total
        | ($usage | map(.input // 0) | add) as $input
        | ($usage | map(.output // 0) | add) as $output
        | ($usage | map(.cacheRead // 0) | add) as $cache_read
        | ($usage | map(.cacheWrite // 0) | add) as $cache_write
        | "\n" + colorize(35;
            "tokens: \($total) total · \($input) in · \($output) out"
            + if ($cache_read + $cache_write) > 0 then
                " · \($cache_read) cache read · \($cache_write) cache write"
              else
                ""
              end
          ) + "\n"
      end;

  if .type == "message_update" then
    .assistantMessageEvent |
    if .type == "thinking_delta" then
      colorize(90; .delta)
    elif .type == "text_delta" then
      .delta
    elif .type == "toolcall_start" then
      "\n" + colorize(36; "→ tool: \(.toolName)") + "\n"
    else empty
    end
  elif .type == "tool_execution_start" then
    "\n" + colorize(36; "→ \(.toolName)") + ": "
      + colorize(33; (.args | tojson)) + "\n"
  elif .type == "tool_execution_end" then
    "\n← \(.toolName): "
      + (if .isError then colorize(31; "ERROR") else colorize(32; "ok") end)
      + "\n"
  elif .type == "agent_end" then
    token_usage(.messages) as $usage
    | if $usage == "" then "\n" else $usage end
  elif .type == "message" and .message.role == "assistant" then
    .message as $message
    | ([
        $message.content[] |
        if .type == "thinking" then
          colorize(90; .thinking)
        elif .type == "text" then
          .text
        elif .type == "toolCall" then
          "\n" + colorize(36; "→ \(.name)") + ": "
            + colorize(33; (.arguments | tojson)) + "\n"
        else
          empty
        end
      ] | join("")) + token_usage([$message])
  elif .type == "message" and .message.role == "toolResult" then
    "\n← \(.message.toolName): "
      + (if .message.isError then colorize(31; "ERROR") else colorize(32; "ok") end)
      + "\n"
  else
    empty
  end
'
