#!/usr/bin/env zsh

fc -W

"$HOME"/dotfiles/scripts/zsh_history_sync.py
"$HOME"/.tmux/plugins/tmux-resurrect/scripts/save.sh

sleep 5

(
  rm -rf "$HOME"/.local/share/tmux/resurrect/*.*
  rm -rf "$HOME"/.local/share/tmux/resurrect/**
  rm -rf "$HOME"/.local/share/tmux/resurrect/.*
) > /dev/null 2>&1 || true

sleep 5

"$HOME"/.tmux/plugins/tmux-resurrect/scripts/save.sh

ls -lah "$HOME"/.local/share/tmux/resurrect

pullall

echo
prline

project_excludes=(
  --exclude='node_modules/'
  --exclude='.omnews-data/'
  --exclude='otaviomiranda.com.br/run_dir/'
  --exclude='dist/'
  --exclude='.venv/'
  --exclude='venv/'
  --exclude='__pycache__/'
  --exclude='.pytest_cache/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
)

# m4128
rsync -havzu --progress --stats "${project_excludes[@]}" "$HOME"/.local/share/tmux/resurrect/ \
  m4128:~/.local/share/tmux/resurrect/ --delete

rsync -havzu --progress --stats "${project_excludes[@]}" \
  --exclude='tutoriais_e_cursos/' \
  "$HOME"/Desktop/tutoriais_e_cursos/ \
  m4128:~/Desktop/tutoriais_e_cursos

echo
prline

# m132
rsync -havzu --progress --stats "$HOME"/.local/share/tmux/resurrect/ \
  fedoraair:~/.local/share/tmux/resurrect/ --delete

rsync -havzu --progress --stats "${project_excludes[@]}" \
  --exclude='tutoriais_e_cursos/' \
  m4128:~/Desktop/tutoriais_e_cursos/ \
  "$HOME"/Desktop/tutoriais_e_cursos/
echo
prline

# fedoraair
rsync -havzu --progress --stats "$HOME"/.local/share/tmux/resurrect/ \
  fedoraair:~/.local/share/tmux/resurrect/ --delete

rsync -havzu --progress --stats "${project_excludes[@]}" \
  --exclude='tutoriais_e_cursos/' \
  "$HOME"/Desktop/tutoriais_e_cursos/ \
  fedoraair:~/Desktop/tutoriais_e_cursos

echo
prline

# Pi agent all
rsync -havzu --progress --stats "${project_excludes[@]}" \
  --exclude='agent/extensions/**/node_modules/' \
  ~/.pi/ fedoraair:~/.pi/

rsync -havzu --progress --stats "${project_excludes[@]}" \
  --exclude='agent/extensions/**/node_modules/' \
  ~/.pi/ m4128:~/.pi/

rsync -havzu --progress --stats "${project_excludes[@]}" \
  --exclude='agent/extensions/**/node_modules/' \
  ~/.pi/ m132:~/.pi/

echo
prline

# Sannux
rsync -havzu --progress --stats "${project_excludes[@]}" ~/sannux-data/ m132:~/sannux-data/
rsync -havzu --progress --stats "${project_excludes[@]}" ~/sannux-data/ m4128:~/sannux-data/
rsync -havzu --progress --stats "${project_excludes[@]}" m4128:~/sannux-data/ ~/sannux-data/
rsync -havzu --progress --stats "${project_excludes[@]}" ~/sannux-data/ fedoraair:~/sannux-data/

echo
prline

# Ollama
rsync -havzu --progress --stats "${project_excludes[@]}" ~/.ollama/service/ m132:~/.ollama/service/
rsync -havzu --progress --stats "${project_excludes[@]}" ~/.ollama/service/ m4128:~/.ollama/service/
rsync -havzu --progress --stats "${project_excludes[@]}" m4128:~/.ollama/service/ ~/.ollama/service/
rsync -havzu --progress --stats "${project_excludes[@]}" ~/.ollama/service/ fedoraair:~/.ollama/service/

echo
prline


# Omxterm
rsync -havzu --progress --stats "${project_excludes[@]}" ~/.config/omxterm/ m132:~/.config/omxterm/
rsync -havzu --progress --stats "${project_excludes[@]}" ~/.config/omxterm/ m4128:~/.config/omxterm/
rsync -havzu --progress --stats "${project_excludes[@]}" m4128:~/.config/omxterm/ ~/.config/omxterm/
rsync -havzu --progress --stats "${project_excludes[@]}" ~/.config/omxterm/ fedoraair:~/.config/omxterm/

echo
prline
