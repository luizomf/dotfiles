#!/usr/bin/env bash

set -euo pipefail

profile="quick"
if [[ "${1:-}" == "--profile" ]]; then
  if [[ $# -lt 2 ]]; then
    printf '[codex_search] error: --profile requires quick or research\n' >&2
    exit 2
  fi
  profile="$2"
  shift 2
elif [[ "${1:-}" == --profile=* ]]; then
  profile="${1#--profile=}"
  shift
fi

case "$profile" in
  quick)
    default_model="${CODEX_SEARCH_QUICK_MODEL:-gpt-5.4-mini}"
    default_reasoning="${CODEX_SEARCH_QUICK_REASONING:-low}"
    ;;
  research)
    default_model="${CODEX_SEARCH_RESEARCH_MODEL:-gpt-5.6-sol}"
    default_reasoning="${CODEX_SEARCH_RESEARCH_REASONING:-medium}"
    ;;
  *)
    printf '[codex_search] error: unsupported profile %q; expected quick or research\n' "$profile" >&2
    exit 2
    ;;
esac

model="${CODEX_SEARCH_MODEL:-$default_model}"
reasoning="${CODEX_SEARCH_REASONING:-$default_reasoning}"

usage() {
  cat <<'EOF'
Usage:
  codex_search [--profile quick|research] [codex exec options] [PROMPT]
  codex_search [--profile quick|research] [codex exec options] - < prompt.md

Profiles:
  quick     Search, scraping, extraction, and source cleanup (default:
            gpt-5.4-mini with low reasoning).
  research  Complex source comparison and synthesis (default: gpt-5.6-sol
            with medium reasoning).

Override profile defaults with CODEX_SEARCH_QUICK_MODEL,
CODEX_SEARCH_QUICK_REASONING, CODEX_SEARCH_RESEARCH_MODEL, and
CODEX_SEARCH_RESEARCH_REASONING. CODEX_SEARCH_MODEL and
CODEX_SEARCH_REASONING remain one-invocation overrides for either profile.

Examples:
  codex_search --profile quick -C /path/to/repo -o /tmp/sources.md - < search-prompt.md
  codex_search --profile research -o /tmp/research.md - < prompt.md
EOF
}

if [[ "${1:-}" == '-h' || "${1:-}" == '--help' ]]; then
  usage
  exit 0
fi

if [[ $# -eq 0 ]]; then
  usage >&2
  printf '\n[codex_search] error: provide a prompt argument or pass - to read stdin\n' >&2
  exit 2
fi

printf '[codex_search] profile=%s model=%s reasoning=%s search=enabled ephemeral=true\n' \
  "$profile" "$model" "$reasoning" >&2

if ! codex \
  --search \
  --model "$model" \
  -c model_reasoning_effort="$reasoning" exec \
  --ephemeral \
  "$@"
then
  printf '[codex_search] error: Codex search failed\n' >&2
  exit 1
fi
