#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=/dev/null
source "${OM_PATHS_FILE:-${script_dir}/../config/paths.sh}"
readonly AUTOMATION_ROOT="${AUTOMATION_ROOT:-${HOME}/.codex/automations/daily-paper-llm-roundup}"
readonly ENV_FILE="${OMNIVOICE_ENV_FILE:-${HOME}/.env}"
readonly POSTS_ROOT="${POSTS_ROOT:-$PROJECTS_DIR/otaviomiranda.com.br/src/content/posts}"
readonly OMNIVOICE_DIR="${OMNIVOICE_DIR:-$PROJECTS_DIR/omnivoicetts}"
readonly AUDIO_PATH="${OMNIVOICE_AUDIO_PATH:-$OMNIVOICE_DIR/outputs/daily-paper/final.opus}"
readonly QUEUE_DIR="${QUEUE_DIR:-${AUTOMATION_ROOT}/hooks/on-end/tts}"
readonly MARKER_PATH="${OMNIVOICE_MARKER:-}"
readonly NODE_BIN="${NODE_BIN:-${HOME}/.nvm/versions/node/v22.18.0/bin/node}"
readonly UV_BIN="${UV_BIN:-${HOME}/.local/bin/uv}"
readonly FFPROBE_BIN="${FFPROBE_BIN:-/opt/homebrew/bin/ffprobe}"

usage() {
  printf 'Usage: %s [--check] [--force] <post-slug>\n' "${0##*/}" >&2
  exit 64
}

check_only=false
force=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      check_only=true
      shift
      ;;
    --force)
      force=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

[[ $# -eq 1 ]] || usage
slug="$1"

if [[ ! "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  printf 'Invalid post slug: %s\n' "$slug" >&2
  exit 64
fi

[[ -r "$ENV_FILE" ]] || {
  printf 'Environment file is not readable: %s\n' "$ENV_FILE" >&2
  exit 66
}

# shellcheck source=/dev/null
source "$ENV_FILE"

required_vars=(
  R2_ACCESS_KEY_ID
  R2_SECRET_ACCESS_KEY
  R2_ENDPOINT
  R2_BUCKET
  R2_PUBLIC_BASE_URL
)

for var_name in "${required_vars[@]}"; do
  if [[ -z "${!var_name:-}" ]]; then
    printf 'Required R2 variable is empty: %s\n' "$var_name" >&2
    exit 78
  fi
done

[[ -x "$NODE_BIN" ]] || {
  printf 'Node executable not found: %s\n' "$NODE_BIN" >&2
  exit 69
}

[[ -x "$FFPROBE_BIN" ]] || {
  printf 'ffprobe executable not found: %s\n' "$FFPROBE_BIN" >&2
  exit 69
}

shopt -s nullglob
post_matches=("$POSTS_ROOT"/[0-9][0-9][0-9][0-9]/"$slug")
shopt -u nullglob

if [[ ${#post_matches[@]} -ne 1 ]]; then
  printf 'Expected exactly one local post for slug %s; found %s.\n' \
    "$slug" "${#post_matches[@]}" >&2
  exit 66
fi

post_dir="${post_matches[0]}"
year="$(basename "$(dirname "$post_dir")")"
tts_path="${post_dir}/tts.txt"

[[ -f "$tts_path" ]] || {
  printf 'TTS source does not exist: %s\n' "$tts_path" >&2
  exit 66
}

[[ -s "$AUDIO_PATH" ]] || {
  printf 'Final OmniVoice audio does not exist or is empty: %s\n' "$AUDIO_PATH" >&2
  exit 66
}

# The OmniVoice output path is shared by every post. Require the newest marker
# for this slug to own the exact final.opus bytes through its recorded identity.
identity_json="$($NODE_BIN - "$QUEUE_DIR" "$tts_path" "$AUDIO_PATH" "$MARKER_PATH" <<'NODE'
const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");

const [queueDir, ttsPath, audioPath, requestedMarker] = process.argv.slice(2);
const resolvedQueue = path.resolve(queueDir);
const target = path.resolve(ttsPath);
const resolvedAudio = path.resolve(audioPath);
const markerNamePattern = /^\d{4}-\d{2}-\d{2}-\d{2}-\d{2}-\d{2}\.json$/;

let latest = null;
let marker = null;

if (requestedMarker) {
  const candidate = path.resolve(requestedMarker);
  if (path.dirname(candidate) !== resolvedQueue || !markerNamePattern.test(path.basename(candidate))) {
    console.error(`Requested marker is outside the trusted queue: ${requestedMarker}`);
    process.exit(65);
  }
  try {
    const data = JSON.parse(fs.readFileSync(candidate, "utf8"));
    if (data.kind === "tts-ready" && path.resolve(data.ttsPath) === target) {
      latest = data;
      marker = candidate;
    }
  } catch {
    // The missing/invalid marker is reported by the common check below.
  }
} else {
  const names = fs.readdirSync(resolvedQueue)
    .filter((name) => markerNamePattern.test(name))
    .sort()
    .reverse();
  for (const name of names) {
    const candidate = path.join(resolvedQueue, name);
    try {
      const data = JSON.parse(fs.readFileSync(candidate, "utf8"));
      if (data.kind === "tts-ready" && path.resolve(data.ttsPath) === target) {
        latest = data;
        marker = candidate;
        break;
      }
    } catch {
      // Ignore malformed/unrelated markers, matching the queue runner.
    }
  }
}

if (!latest) {
  console.error("No TTS marker exists for this post.");
  process.exit(66);
}

if (latest.status !== "succeeded" || latest.exitCode !== 0) {
  console.error(`Latest TTS marker is not successful: ${marker} (${latest.status})`);
  process.exit(75);
}

if (
  typeof latest.audioPath !== "string" || path.resolve(latest.audioPath) !== resolvedAudio ||
  !Number.isSafeInteger(latest.audioSize) || latest.audioSize <= 0 ||
  typeof latest.audioSha256 !== "string" || !/^[a-f0-9]{64}$/.test(latest.audioSha256)
) {
  console.error(`Successful marker has no valid audio identity: ${marker}`);
  process.exit(65);
}

const audio = fs.readFileSync(resolvedAudio);
const sha256 = crypto.createHash("sha256").update(audio).digest("hex");
if (audio.length !== latest.audioSize || sha256 !== latest.audioSha256) {
  console.error(`final.opus does not match the successful marker: ${marker}`);
  process.exit(65);
}

console.log(JSON.stringify({ marker, audioSize: latest.audioSize, audioSha256: latest.audioSha256 }));
NODE
)"
marker="$($NODE_BIN -e 'console.log(JSON.parse(process.argv[1]).marker)' "$identity_json")"
audio_size="$($NODE_BIN -e 'console.log(JSON.parse(process.argv[1]).audioSize)' "$identity_json")"
audio_sha256="$($NODE_BIN -e 'console.log(JSON.parse(process.argv[1]).audioSha256)' "$identity_json")"

codec="$($FFPROBE_BIN -v error -select_streams a:0 \
  -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 \
  "$AUDIO_PATH")"

if [[ "$codec" != "opus" ]]; then
  printf 'Expected Opus audio, found codec: %s\n' "${codec:-unknown}" >&2
  exit 65
fi

object_key="content/posts/${year}/${slug}/final.opus"
public_url="${R2_PUBLIC_BASE_URL%/}/${object_key}"

if [[ "$check_only" == true ]]; then
  printf 'Ready to upload.\nmarker=%s\naudio=%s\nobject=%s/%s\nurl=%s\n' \
    "$marker" "$AUDIO_PATH" "$R2_BUCKET" "$object_key" "$public_url"
  exit 0
fi

[[ -x "$UV_BIN" ]] || {
  printf 'uv executable not found: %s\n' "$UV_BIN" >&2
  exit 69
}

force_arg=0
[[ "$force" == true ]] && force_arg=1

"$UV_BIN" run --quiet --with 'boto3>=1.40,<2' python - \
  "$R2_ENDPOINT" "$R2_BUCKET" "$object_key" "$AUDIO_PATH" \
  "$public_url" "$force_arg" "$audio_sha256" "$audio_size" <<'PY'
import hashlib
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

import boto3
from botocore.exceptions import ClientError

(
    endpoint,
    bucket,
    object_key,
    audio_path,
    public_url,
    force_arg,
    expected_sha256,
    expected_size_arg,
) = sys.argv[1:]
force = force_arg == "1"
expected_size = int(expected_size_arg)

with open(audio_path, "rb") as audio_file:
    audio = audio_file.read()
sha256 = hashlib.sha256(audio).hexdigest()
size = len(audio)
if sha256 != expected_sha256 or size != expected_size:
    print("final.opus changed after marker validation.", file=sys.stderr)
    raise SystemExit(65)

def verify_public_audio():
    separator = "&" if "?" in public_url else "?"
    verification_url = (
        f"{public_url}{separator}sha256={urllib.parse.quote(sha256)}"
    )
    last_error = None
    for attempt in range(5):
        try:
            request = urllib.request.Request(
                verification_url,
                headers={"Cache-Control": "no-cache"},
            )
            with urllib.request.urlopen(request, timeout=30) as response:
                public_audio = response.read()
            if len(public_audio) == size and hashlib.sha256(public_audio).hexdigest() == sha256:
                return
            last_error = RuntimeError("public object content does not match uploaded audio")
        except (OSError, urllib.error.URLError) as error:
            last_error = error
        if attempt < 4:
            time.sleep(2)
    print(f"Canonical public audio verification failed: {last_error}", file=sys.stderr)
    raise SystemExit(74)

s3 = boto3.client(
    "s3",
    endpoint_url=endpoint,
    region_name="auto",
    aws_access_key_id=os.environ["R2_ACCESS_KEY_ID"],
    aws_secret_access_key=os.environ["R2_SECRET_ACCESS_KEY"],
)

existing = None
try:
    existing = s3.head_object(Bucket=bucket, Key=object_key)
except ClientError as error:
    status = error.response.get("ResponseMetadata", {}).get("HTTPStatusCode")
    if status != 404:
        raise

if existing:
    existing_hash = existing.get("Metadata", {}).get("sha256")
    existing_size = existing.get("ContentLength")
    if existing_hash == sha256 and existing_size == size:
        verify_public_audio()
        print(f"Audio already uploaded: {public_url}")
        raise SystemExit(0)
    if not force:
        print(
            "R2 object already exists with different content; use --force to replace it.",
            file=sys.stderr,
        )
        raise SystemExit(73)

result = s3.put_object(
    Bucket=bucket,
    Key=object_key,
    Body=audio,
    ContentType="audio/ogg",
    Metadata={"sha256": sha256},
)

verified = s3.head_object(Bucket=bucket, Key=object_key)
if (
    verified.get("ContentLength") != size or
    verified.get("Metadata", {}).get("sha256") != sha256
):
    print("Uploaded object identity does not match the local audio.", file=sys.stderr)
    raise SystemExit(74)

verify_public_audio()
print(f"Uploaded: {public_url}")
print(f"ETag: {result.get('ETag', 'unknown')}")
PY
