#!/usr/bin/env bash

set -euo pipefail

readonly repo="${OMQUEUE_REPO:-${HOME}/Desktop/tutoriais_e_cursos/omqueue}"
readonly entrypoint="${repo}/dist/src/bin.js"

if [[ ! -f "$entrypoint" ]]; then
  printf 'omqueue: built entrypoint not found: %s\n' "$entrypoint" >&2
  printf 'omqueue: build the repository or set OMQUEUE_REPO\n' >&2
  exit 1
fi

if command -v node >/dev/null 2>&1; then
  node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)"
  if [[ "$node_major" =~ ^[0-9]+$ ]] && ((node_major >= 24)); then
    exec node "$entrypoint" "$@"
  fi
fi

readonly nvm_dir="${NVM_DIR:-${HOME}/.nvm}"
readonly nvm_script="${nvm_dir}/nvm.sh"
if [[ -s "$nvm_script" ]]; then
  export NODE_VERSION="${OMQUEUE_NODE_VERSION:-default}"
  # shellcheck disable=SC1090
  . "$nvm_script" --no-use
  nvm_node="$(nvm which "$NODE_VERSION" 2>/dev/null || true)"
  if [[ -x "$nvm_node" ]]; then
    exec "$nvm_node" "$entrypoint" "$@"
  fi
fi

printf 'omqueue: Node.js 24+ not found on PATH or through NVM: %s\n' "$nvm_script" >&2
exit 127
