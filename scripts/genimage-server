#!/usr/bin/env python3
# Copyright (c) 2026 Luiz Otávio Miranda
"""genimage-server: a tiny local HTTP front for `genimage`.

POST /generate?model=<name> with the prompt as the request body returns one
PNG. GET /health returns "ok". It listens on 127.0.0.1 only; a reverse proxy
(Caddy on fedoraair) decides who may reach it. Requests run one at a time.
"""

import os
import subprocess
import tempfile
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

GENIMAGE = str(Path(__file__).resolve().with_name("genimage"))
MODELS = {"z-image", "qwen", "flux3"}
DEFAULT_MODEL = os.environ.get("GENIMAGE_MODEL", "flux3")
MAX_PROMPT_BYTES = 16 * 1024
TIMEOUT_SECONDS = int(os.environ.get("GENIMAGE_TIMEOUT", "1200"))
LOCK = threading.Lock()


class Handler(BaseHTTPRequestHandler):
  def reply(
    self,
    status: int,
    body: "bytes | str",
    content_type: str = "text/plain; charset=utf-8",
  ) -> None:
    data = (body + "\n").encode() if isinstance(body, str) else body
    self.send_response(status)
    self.send_header("Content-Type", content_type)
    self.send_header("Content-Length", str(len(data)))
    self.end_headers()
    self.wfile.write(data)

  def do_GET(self) -> None:
    if urlparse(self.path).path == "/health":
      self.reply(200, "ok")
    else:
      self.reply(404, "not found")

  def do_POST(self) -> None:
    url = urlparse(self.path)
    if url.path != "/generate":
      self.reply(404, "not found")
      return
    model = parse_qs(url.query).get("model", [DEFAULT_MODEL])[0]
    if model not in MODELS:
      self.reply(400, f"unknown model: {model}")
      return
    length = int(self.headers.get("Content-Length") or 0)
    if not 0 < length <= MAX_PROMPT_BYTES:
      self.reply(400, f"prompt must be 1..{MAX_PROMPT_BYTES} bytes")
      return
    prompt = self.rfile.read(length)

    with LOCK, tempfile.TemporaryDirectory() as tmp:
      out = Path(tmp) / "image.png"
      try:
        result = subprocess.run(  # noqa: S603 - fixed argv; prompt goes to stdin
          [GENIMAGE, "-m", model, "-o", str(out), "-f", "-"],
          input=prompt,
          capture_output=True,
          timeout=TIMEOUT_SECONDS,
          check=False,
        )
      except subprocess.TimeoutExpired:
        self.reply(504, "generation timed out")
        return
      if result.returncode != 0 or not out.is_file():
        tail = result.stderr.decode(errors="replace")[-2000:]
        self.reply(502, f"generation failed ({result.returncode}): {tail}")
        return
      self.reply(200, out.read_bytes(), "image/png")

  def log_message(self, format: str, *args: object) -> None:  # noqa: A002
    print(f"{self.address_string()} {format % args}", flush=True)


if __name__ == "__main__":
  port = int(os.environ.get("GENIMAGE_PORT", "3790"))
  ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
