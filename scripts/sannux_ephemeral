#!/usr/bin/env bash

set -euo pipefail

# Examples
# echo "Testing. Please, answer: 'OK'" | sannux_ephemeral codex exec --ephemeral --yolo 2>/dev/null
# echo "Testing. Please, answer: 'OK'" | sannux_ephemeral codex-ollama exec --ephemeral --yolo 2>/dev/null
# echo "Testing. Please, answer: 'OK'" | sannux_ephemeral claude-code --no-session-persistence --dangerously-skip-permissions -p - 2>/dev/null
# echo "Testing. Please, answer: 'OK'" | sannux_ephemeral claude-ollama --no-session-persistence --dangerously-skip-permissions -p - 2>/dev/null
# sannux_ephemeral --refresh-pi-resources  # Sync the current host Pi extensions and skills
# sannux_ephemeral pi --shell              # Open Bash with the same ephemeral mounts

CURDIR="${CURDIR:-"$(pwd)"}"

: "${PROJECTS_DIR:?Set PROJECTS_DIR before running sannux}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dotfiles_dir="$(cd "${script_dir}/.." && pwd)"
sannux_dir="${PROJECTS_DIR%/}/sannux"

resolve_agent_home() (
  local template="${1:?Set the Sannux template name}"
  cd "${sannux_dir}/templates/${template}"
  # shellcheck disable=SC1091
  source .env

  local agent_home="${AGENT_HOME_PATH:-${HOME}/sannux-data/agent-homes/${template}}"
  agent_home="${agent_home/#\~/$HOME}"
  printf '%s\n' "$agent_home"
)

refresh_pi_resources() (
  local template_dir="${sannux_dir}/templates/pi"
  local host_agent_dir="${HOME}/.pi/agent"

  test -d "$template_dir"
  test -d "$host_agent_dir/extensions"
  test -d "$host_agent_dir/skills"

  local persistent_home
  persistent_home="$(resolve_agent_home pi)"
  # This assignment is isolated inside the refresh subshell.
  # shellcheck disable=SC2030
  local AGENT_HOME_PATH="$persistent_home"
  export AGENT_HOME_PATH

  cd "$template_dir"
  test -d "$persistent_home"
  if [[ -z "$persistent_home" || "$persistent_home" == "/" || "$persistent_home" == "$HOME" ]]; then
    printf 'Unsafe Pi home for resource refresh: %s\n' "$persistent_home" >&2
    return 1
  fi

  local stage
  stage="$(mktemp -d "${persistent_home}/.pi-resources.XXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  mkdir -p "$stage/extensions" "$stage/skills"

  # Follow deployed symlinks so the snapshot is a self-contained copy of every
  # extension currently loaded from the host Pi directory. Rebuild npm
  # dependencies in Linux instead of copying host-specific node_modules.
  rsync -aL --exclude='node_modules/' \
    "$host_agent_dir/extensions/" "$stage/extensions/"
  rsync -aL --exclude='node_modules/' --exclude='.omskills-managed-links' \
    "$host_agent_dir/skills/" "$stage/skills/"

  local stage_name="${stage##*/}"
  local package_json package_dir package_suffix
  local -a npm_args
  while IFS= read -r -d '' package_json; do
    package_dir="${package_json%/*}"
    package_suffix="${package_dir#"$stage"/}"
    npm_args=(install --package-lock=false)
    if [[ -f "$package_dir/package-lock.json" ]]; then
      npm_args=(ci)
    fi
    docker compose run --rm -T --entrypoint npm agent \
      "${npm_args[@]}" --prefix "/home/agent/${stage_name}/${package_suffix}" --omit=dev
  done < <(find "$stage/extensions" -type f -name package.json -print0)

  local agent_dir="${persistent_home}/.pi/agent"
  mkdir -p "$agent_dir"
  local resource
  for resource in extensions skills; do
    local target="${agent_dir}/${resource}"
    local backup="${agent_dir}/.${resource}.previous.$$"
    if [[ -e "$target" || -L "$target" ]]; then
      mv "$target" "$backup"
    fi
    mv "$stage/$resource" "$target"
    if [[ -e "$backup" || -L "$backup" ]]; then
      rm -r "$backup"
    fi
  done

  mkdir -p "${persistent_home}/.local/bin" "${persistent_home}/.codex"
  install -m 0755 "$dotfiles_dir/scripts/codex_search" \
    "${persistent_home}/.local/bin/codex_search"
  install -m 0755 "$dotfiles_dir/scripts/bq" \
    "${persistent_home}/.local/bin/bq"

  # Codex now ships in the Sannux Pi image. Remove the legacy per-home package
  # once so it cannot shadow the image-managed binary on future runs.
  if [[ -f "${persistent_home}/.local/package.json" ]] \
    && grep -q '"@openai/codex"' "${persistent_home}/.local/package.json"; then
    docker compose run --rm -T --entrypoint npm agent \
      uninstall --prefix /home/agent/.local @openai/codex
  fi

  local sannux_codex_home
  sannux_codex_home="$(resolve_agent_home codex)"
  if [[ -f "${sannux_codex_home}/.codex/auth.json" ]]; then
    install -m 0600 \
      "${sannux_codex_home}/.codex/auth.json" \
      "${persistent_home}/.codex/auth.json"
  fi

  printf 'extensions_source=%s\nrefreshed_at=%s\n' \
    "${host_agent_dir}/extensions" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >"${agent_dir}/RESOURCE_SNAPSHOT"
  printf 'Refreshed current Pi resources from %s\n' "$host_agent_dir"
)

if [[ "${1:-}" == "--refresh-pi-resources" ]]; then
  refresh_pi_resources
  exit $?
fi

cd "$sannux_dir" || exit 1
template="${1:?'Usage: sannux_ephemeral <template_name>|--refresh-pi-resources'}"

cd "templates/$template" || exit 1

# EPHEMERAL
persistent_home="$(resolve_agent_home "$template")"
# refresh_pi_resources cannot mutate this shell.
# shellcheck disable=SC2031
export AGENT_HOME_PATH="$persistent_home"
if [[ -z "$persistent_home" || "$persistent_home" == "/" \
  || "$persistent_home" == "$HOME" || "$persistent_home" == "$HOME/" ]]; then
  printf 'Unsafe persistent home for ephemeral run: %s\n' "$persistent_home" >&2
  exit 1
fi
persistent_home="${persistent_home%/}"
test -d "$persistent_home"

# Keep each run isolated while grouping it under a predictable host namespace.
# The random suffix prevents concurrent invocations from sharing mutable state.
ephemeral_home_root="${persistent_home}.ephemeral-runs"
mkdir -p "$ephemeral_home_root"
chmod 0700 "$ephemeral_home_root"
tmp_home="$(mktemp -d "${ephemeral_home_root}/run.XXXXXX")"
tmp_workspace="$CURDIR"

# THE HOME WILL BE REMOVED AFTER DONE
trap 'rm -rf "$tmp_home"' EXIT

mkdir -p "$tmp_workspace"

# The host-owned bind mount may not match the container user's UID. Trust only
# the fixed container workspace through the ephemeral Git configuration.
git config --file "$tmp_home/.gitconfig" --add safe.directory /workspace

host_git_name="$(git config --global --get user.name || true)"
host_git_email="$(git config --global --get user.email || true)"
if [[ -n "$host_git_name" && -n "$host_git_email" ]]; then
  git config --file "$tmp_home/.gitconfig" user.name "$host_git_name"
  git config --file "$tmp_home/.gitconfig" user.email "$host_git_email"
fi

case $template in
  codex|codex-ollama)
    mkdir -p "${tmp_home}/.codex"
    cp "$persistent_home/.codex/config.toml" "$tmp_home/.codex/config.toml"

    if [[ -f "$persistent_home/.codex/auth.json" ]]; then
      cp "$persistent_home/.codex/auth.json" "$tmp_home/.codex/auth.json"
    fi

    if [[ -f "$persistent_home/.codex/AGENTS.md" ]]; then
      cp "$persistent_home/.codex/AGENTS.md" "$tmp_home/.codex/AGENTS.md"
    fi
    shift
    ;;
  claude-code)
    mkdir -p "${tmp_home}"
    cp -a "$persistent_home"/. "$tmp_home"/
    shift
    ;;
  claude-ollama)
    mkdir -p "${tmp_home}"
    cp -rf "$persistent_home/.claude/" "$tmp_home/.claude/"

    if [[ -f "$persistent_home/.claude.json" ]]; then
      cp "$persistent_home/.claude.json" "$tmp_home/.claude.json"
    fi

    shift
    ;;
  agy)
    mkdir -p "${tmp_home}"
    cp -a "$persistent_home"/. "$tmp_home"/
    shift
    ;;
  pi)
    mkdir -p "${tmp_home}"
    cp -a "$persistent_home"/. "$tmp_home"/

    # Nested Codex calls in Pi use the same current authentication as the
    # persistent Sannux Codex runner, never the host Codex session.
    sannux_codex_home="$(resolve_agent_home codex)"
    rm -f "${tmp_home}/.codex/auth.json"
    if [[ -f "${sannux_codex_home}/.codex/auth.json" ]]; then
      mkdir -p "${tmp_home}/.codex"
      install -m 0600 \
        "${sannux_codex_home}/.codex/auth.json" \
        "${tmp_home}/.codex/auth.json"
    fi

    shift
    ;;
  *)
    printf "%b\n" "Template not configured"
    exit 1
esac

shell_mode=0
if [[ "${1:-}" == "--shell" ]]; then
  shell_mode=1
  shift
fi

declare -a docker_cmd=(
  docker compose run
  -v "$tmp_workspace:/workspace"
  -v "$tmp_home:/home/agent"
  --rm
)

if ((shell_mode)); then
  docker_cmd+=(--entrypoint bash)
fi

if [[ "$template" == "pi" ]]; then
  docker_cmd+=(
    -e 'PATH=/home/agent/.local/bin:/home/agent/.local/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
  )
fi

# STDIN
if [[ ! -t 0 ]]; then
  docker_cmd+=(-T agent)

  "${docker_cmd[@]}" "${@}"
  exit $?
fi

docker_cmd+=(-it agent)
"${docker_cmd[@]}" "${@}"
exit $?
