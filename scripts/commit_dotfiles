#!/usr/bin/env bash

set -euo pipefail

message=${1:-}
if [[ -z "$message" ]]; then
  printf 'Action cancelled: commit message is required.\n'
  exit 0
fi

readonly dotfiles_dir="${HOME}/dotfiles"
readonly hosts=(m132 m4128 fedoraair)

cd "$dotfiles_dir"
git add .

# Defense in depth: ignored files normally cannot be staged by `git add`, but
# an already tracked or force-added sensitive file can. Refuse to publish any
# staged path covered by the repository's ignore policy.
declare -a ignored_staged=()
while IFS= read -r -d '' path; do
  ignored_staged+=("$path")
done < <(
  git diff --cached --name-only --diff-filter=ACMR -z |
    git check-ignore --no-index --stdin -z 2>/dev/null || true
)

if (( ${#ignored_staged[@]} > 0 )); then
  printf 'Action cancelled: sensitive or local-only paths are staged:\n' >&2
  printf '  %q\n' "${ignored_staged[@]}" >&2
  git reset -q -- "${ignored_staged[@]}"
  exit 1
fi

if git diff --cached --quiet; then
  printf 'No local changes to commit.\n'
else
  git commit -m "$message"
fi

git push

for host in "${hosts[@]}"; do
  printf 'Updating %s...\n' "$host"
  ssh -T -o BatchMode=yes "$host" 'git -C ~/dotfiles pull --ff-only'
done
