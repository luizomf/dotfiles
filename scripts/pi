#!/usr/bin/env bash

set -euo pipefail

t="${t:-}"

wrapper_path="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/$(basename -- "${BASH_SOURCE[0]}")"
real_pi=""

while IFS= read -r candidate; do
  if [[ "$candidate" != "$wrapper_path" ]]; then
    real_pi="$candidate"
    break
  fi
done < <(type -aP pi)

if [[ -z "$real_pi" ]]; then
  printf 'pi wrapper: could not find the underlying pi executable\n' >&2
  exit 127
fi

declare -a pi_cmd=(
  "$real_pi" --no-skills --skill "${HOME}/.pi/agent/skills"
)

if [[ -n "$t" ]]; then
  title "$t"
  exec "${pi_cmd[@]}" --name "$t" "$@"
else
  title "$(basename "$(pwd)")"
  exec "${pi_cmd[@]}" "$@"
fi
