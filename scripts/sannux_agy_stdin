#!/usr/bin/env bash

set -euo pipefail

if [[ -t 0 ]]; then
  printf 'Usage: prompt | sannux_agy_stdin [agy arguments]\n' >&2
  exit 2
fi

# Antigravity appends stdin to the non-empty --print prompt. Keep the Omnews
# prompt on stdin: placing it in argv makes Docker fail for large briefings.
prompt_file="$(mktemp)"
trap 'rm -f "$prompt_file"' EXIT
cat > "$prompt_file"

if [[ ! -s "$prompt_file" ]]; then
  printf 'sannux_agy_stdin: stdin prompt is empty\n' >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "agy" ]]; then
  shift
fi

"$script_dir/sannux_ephemeral" agy "$@" --print 'Follow the instructions supplied through stdin.' < "$prompt_file"
