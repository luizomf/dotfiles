#!/usr/bin/env bash

set -euo pipefail

if [[ -t 0 ]]; then
  printf 'Usage: prompt | sannux_agy_stdin [agy arguments]\n' >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "agy" ]]; then
  shift
fi

agy_args=("$@")
print_timeout_seconds="${OMNEWS_AI_TIMEOUT_SECONDS:-900}"
if [[ ! "$print_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  printf 'sannux_agy_stdin: OMNEWS_AI_TIMEOUT_SECONDS must be a positive integer\n' >&2
  exit 2
fi

has_print_timeout=0
# The ${a[@]+...} form keeps empty arrays safe under set -u in Bash 3.2.
for arg in ${agy_args[@]+"${agy_args[@]}"}; do
  if [[ "$arg" == "--print-timeout" || "$arg" == --print-timeout=* ]]; then
    has_print_timeout=1
    break
  fi
done
if (( ! has_print_timeout )); then
  agy_args+=(--print-timeout "${print_timeout_seconds}s")
fi

message_file="$(mktemp)"
output_file="$(mktemp)"
trap 'rm -f "$message_file" "$output_file"' EXIT

# Antigravity's stream-json input reads each turn from stdin, so large prompts
# stay out of argv. Do not ask the agent to read the prompt from a file: that
# costs extra tool turns, and short prompts can spiral into minutes of tools.
python3 -c '
import json, sys
prompt = sys.stdin.read()
if not prompt:
    sys.exit("sannux_agy_stdin: stdin prompt is empty")
message = {"event": "user", "message": {"role": "user", "content": prompt}}
print(json.dumps(message))
' >"$message_file" || exit 2

set +e
"$script_dir/sannux_ephemeral" agy ${agy_args[@]+"${agy_args[@]}"} \
  --input-format stream-json --output-format stream-json --print "" \
  <"$message_file" >"$output_file"
status=$?
set -e

# Print only the final answer of a complete, successful turn.
python3 - "$output_file" "$status" <<'PY'
import json
import sys

path, status = sys.argv[1], int(sys.argv[2])
result = None
with open(path, encoding="utf-8", errors="replace") as stream:
    for line in stream:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get("event") == "result":
            result = event.get("result") or {}


def fail(reason: str) -> None:
    print(f"sannux_agy_stdin: {reason}", file=sys.stderr)
    sys.exit(status or 1)


if status:
    detail = f": {result.get('error')}" if result and result.get("error") else ""
    fail(f"Antigravity exited with {status}{detail}")
if result is None:
    fail("Antigravity stream had no result event")
if result.get("status") != "SUCCESS":
    fail(f"Antigravity status {result.get('status')}: {result.get('error', '')}")
if result.get("finished_reason"):
    fail(f"Antigravity turn ended early: {result['finished_reason']}")
sys.stdout.write(result.get("response", ""))
PY
