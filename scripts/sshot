#!/usr/bin/env bash
# Arm one new clipboard-image upload on the local Mac; no capture UI is opened.
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
helper="$root/lib/sshot-clipboard.js"
umask 077

usage() {
  printf 'Usage: sshot <ssh-alias>\nWait in the background for one NEW clipboard image (120 seconds).\n'
}

# Private continuation; the public invocation takes the initial clipboard revision
# before detaching, so an image copied immediately after arming is not missed.
if [[ ${1:-} == --worker && $# == 4 ]]; then
  host=$2 work=$3 baseline=$4
  image="$work/screenshot.png"
  trap 'rm -f -- "$image"' EXIT
  /usr/bin/osascript -l JavaScript "$helper" "$image" "$baseline" "$work/cancel"
  [[ ! -e $work/cancel && -s $image ]] || exit 0
  remote=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" 'umask 077; mktemp -d /tmp/sshot.XXXXXXXXXX')
  [[ $remote =~ ^/tmp/sshot\.[a-zA-Z0-9]{10}$ ]] || { echo 'sshot: invalid remote path' >&2; exit 1; }
  remote_file="$remote/screenshot.png"
  printf 'Destination: %s:%s\n' "$host" "$remote_file"
  if ! scp -o BatchMode=yes -o ConnectTimeout=10 "$image" "$host:$remote_file"; then
    printf 'sshot: upload failed; clipboard unchanged. A partial remote file may remain.\n' >&2
    exit 1
  fi
  if ! printf '%s' "$remote_file" | /usr/bin/pbcopy; then
    printf 'sshot: uploaded, but clipboard copy failed; use the destination above.\n' >&2
    exit 1
  fi
  printf 'Uploaded; remote path copied to clipboard.\n'
  exit 0
fi
if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
[[ $# == 1 && $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || {
  usage >&2
  printf 'Use an SSH config alias, not a URL, option, or user@host.\n' >&2
  exit 64
}
[[ $(uname -s) == Darwin ]] || { echo 'sshot: run on the local Mac, outside SSH' >&2; exit 1; }
for tool in ssh scp nohup mktemp; do
  command -v "$tool" >/dev/null || { printf 'sshot: missing command: %s\n' "$tool" >&2; exit 1; }
done
[[ -x /usr/bin/osascript && -x /usr/bin/pbcopy && -r $helper ]] || {
  echo 'sshot: missing macOS tools or scripts/lib/sshot-clipboard.js' >&2; exit 1;
}
# Read only the revision counter, never the initial clipboard content.
baseline=$(/usr/bin/osascript -l JavaScript "$helper" --count)
work=$(mktemp -d "${TMPDIR:-/tmp}/sshot-watch.XXXXXXXXXX")
nohup /bin/bash "$root/sshot" --worker "$1" "$work" "$baseline" </dev/null >"$work/status.log" 2>&1 &
printf 'Armed for %s: next NEW clipboard image within 120s (one upload only).\n' "$1"
printf 'Close the popup, then use Ctrl+Shift+Cmd+4. SSH must work without prompts.\n'
printf 'Cancel while waiting: touch %q\nPrivate status log: %s/status.log\n' "$work/cancel" "$work"
