#!/usr/bin/env bash

set -euo pipefail

if (( $# < 1 || $# > 4 )); then
  echo "Uso: $0 arquivo [diretório-de-saída] [prefixo] [percentual-da-primeira-parte]" >&2
  exit 2
fi

file="$1"
outdir="${2:-$PWD/outputs}"
prefix="${3:-half}"
first_share="${4:-50}"

if [[ ! "$first_share" =~ ^[0-9]+$ ]] || (( first_share < 1 || first_share > 99 )); then
  echo "Percentual inválido para a primeira parte: $first_share (esperado: 1-99)" >&2
  exit 2
fi

[[ -f "$file" ]] || {
  echo "Arquivo não encontrado: $file" >&2
  return 1
}

mkdir -p "$outdir"

half_1="$outdir/${prefix}-1.txt"
half_2="$outdir/${prefix}-2.txt"

declare lines first_lines
lines=$(wc -l < "$file")
first_lines=$(( (lines * first_share + 99) / 100 ))

head -n "$first_lines" "$file" > "$half_1"
tail -n +"$((first_lines + 1))" "$file" > "$half_2"

echo "Criado:"
echo "$half_1"
echo "$half_2"
