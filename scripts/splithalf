#!/usr/bin/env bash

set -euo pipefail

file="$1"
outdir="${2:-$HOME/Desktop}"
prefix="${3:-metade}"
first_share="${4:-50}"

if [[ ! "$first_share" =~ ^[0-9]+$ ]] || (( first_share < 1 || first_share > 99 )); then
  echo "Percentual inválido para a primeira parte: $first_share (esperado: 1-99)" >&2
  exit 2
fi

[[ -f "$file" ]] || {
  echo "Arquivo não encontrado: $file" >&2
  return 1
}

mkdir -p "$outdir"

declare lines first_lines
lines=$(wc -l < "$file")
first_lines=$(( (lines * first_share + 99) / 100 ))

head -n "$first_lines" "$file" > "$outdir/${prefix}-1.txt"
tail -n +"$((first_lines + 1))" "$file" > "$outdir/${prefix}-2.txt"

echo "Criado:"
echo "$outdir/${prefix}-1.txt"
echo "$outdir/${prefix}-2.txt"
