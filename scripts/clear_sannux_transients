#!/usr/bin/env python3
# Copyright (c) 2026 Luiz Otávio Miranda
"""Explicit idle maintenance, not runtime-history retention or launcher cleanup."""

import argparse
import json
import os
import re
import shutil
import stat
import subprocess
from collections.abc import Callable
from pathlib import Path

NAMESPACE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*\.ephemeral-runs")
RUN = re.compile(r"run\.[A-Za-z0-9]{6}")
PROCESS_FIELDS = 2


def directory(path: Path) -> tuple[int, int]:
  info = path.lstat()
  if (
    not stat.S_ISDIR(info.st_mode)
    or path.resolve() != path
    or info.st_uid != os.getuid()
  ):
    message = f"Refusing noncanonical, symlinked or foreign directory: {path}"
    raise RuntimeError(message)
  return info.st_dev, info.st_ino


def plan(home: Path) -> tuple[Path, list[Path], list[Path]]:
  home = Path(home)
  directory(home)
  root = home / "sannux-data" / "agent-homes"
  if not root.exists() and not root.is_symlink():
    return root, [], []
  directory(root.parent)
  directory(root)
  candidates: list[Path] = []
  preserved: list[Path] = []
  for namespace in sorted(root.iterdir()):
    if NAMESPACE.fullmatch(namespace.name):
      directory(namespace)
      for entry in sorted(namespace.iterdir()):
        if RUN.fullmatch(entry.name):
          directory(entry)
          candidates.append(entry)
        else:
          preserved.append(entry)
    elif namespace.name.endswith(".ephemeral-runs"):
      preserved.append(namespace)
    elif namespace.name == "pi-daily-paper-sessions":
      directory(namespace)
      candidates.extend(sorted(namespace.iterdir()))
  return root, candidates, preserved


def command(*argv: str) -> str:
  # Every caller supplies a fixed executable and internally constructed arguments.
  return subprocess.check_output(argv, text=True, timeout=15)  # noqa: S603


def assert_idle(root: Path) -> None:
  # Do not signal Pi, Omnews, Docker, or user processes. Refuse ambiguity.
  processes = command("ps", "-axo", "pid=,command=")
  for line in processes.splitlines():
    fields = line.strip().split(None, 1)
    if len(fields) != PROCESS_FIELDS or fields[0] == str(os.getpid()):
      continue
    args = fields[1]
    if "sannux_ephemeral" in args or "run-pi-ephemeral.sh" in args or str(root) in args:
      message = "A launcher or process references agent homes; maintenance is not idle"
      raise RuntimeError(message)
  endpoint = command(
    "docker", "context", "inspect", "--format", "{{.Endpoints.docker.Host}}"
  ).strip()
  if not endpoint.startswith("unix://") or (
    os.environ.get("DOCKER_HOST")
    and not os.environ["DOCKER_HOST"].startswith("unix://")
  ):
    message = "A reachable local Unix-socket Docker context is required"
    raise RuntimeError(message)
  ids = command("docker", "ps", "-q").split()
  for ident in ids:
    records = json.loads(command("docker", "inspect", ident))
    if len(records) != 1:
      message = "Ambiguous container inspection"
      raise RuntimeError(message)
    for mount in records[0].get("Mounts", []):
      source = Path(mount["Source"]).resolve()
      if source == root or root in source.parents or source in root.parents:
        message = f"Container {ident} mounts agent homes; refusing cleanup"
        raise RuntimeError(message)


def validate_tree(path: Path) -> None:
  # Never cross a mounted filesystem or follow a link inside a disposable tree.
  if path.is_symlink() or not path.is_dir():
    return
  if os.path.ismount(path):
    message = f"Refusing mounted directory: {path}"
    raise RuntimeError(message)
  for current, dirs, _ in os.walk(path, followlinks=False):
    for name in dirs:
      child = Path(current) / name
      if not child.is_symlink() and os.path.ismount(child):
        message = f"Refusing mounted directory: {child}"
        raise RuntimeError(message)


def remove_validated(
  root: Path,
  entries: list[Path],
  identities: dict[Path, tuple[int, int, int]],
  parents: dict[Path, tuple[int, int]],
  idle_check: Callable[[Path], None],
) -> None:
  if not shutil.rmtree.avoids_symlink_attacks:
    message = "This Python lacks symlink-safe directory removal"
    raise RuntimeError(message)
  idle_check(root)
  for parent, identity in parents.items():
    if directory(parent) != identity:
      message = "Cleanup parent changed after validation"
      raise RuntimeError(message)
  # This is deliberately manual, quiescent maintenance. The checks are
  # not a lock against a new launcher: keep all work idle until it ends.
  for entry in entries:
    if directory(entry.parent) != parents[entry.parent]:
      message = "Cleanup parent changed after validation"
      raise RuntimeError(message)
    info = entry.lstat()
    if (info.st_dev, info.st_ino, info.st_mode) != identities[entry]:
      message = "Cleanup entry changed after validation"
      raise RuntimeError(message)
    if stat.S_ISDIR(info.st_mode):
      shutil.rmtree(entry)
    else:
      entry.unlink()  # Includes symlinks themselves, never their targets.


def clean(
  home: Path,
  apply: bool = False,  # noqa: FBT001, FBT002 - preserved callable contract
  idle_check: Callable[[Path], None] = assert_idle,
) -> tuple[list[Path], list[Path]]:
  root, entries, preserved = plan(home)
  if not entries:
    return entries, preserved
  idle_check(root)
  identities: dict[Path, tuple[int, int, int]] = {}
  parents: dict[Path, tuple[int, int]] = {}
  for entry in entries:
    parents[entry.parent] = directory(entry.parent)
    info = entry.lstat()
    identities[entry] = (info.st_dev, info.st_ino, info.st_mode)
    validate_tree(entry)
  if apply:
    remove_validated(root, entries, identities, parents, idle_check)
  return entries, preserved


def main() -> None:
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--apply", action="store_true")
  parser.add_argument(
    "--idle-confirmed",
    action="store_true",
    help="Operator confirms all work and publication continuations are idle",
  )
  args = parser.parse_args()
  if args.apply and not args.idle_confirmed:
    parser.error(
      "--apply requires --idle-confirmed; this command never stops consumers"
    )
  try:
    entries, preserved = clean(Path.home(), args.apply)
  except (OSError, RuntimeError, subprocess.SubprocessError, ValueError) as error:
    parser.exit(1, f"Cleanup refused: {error}\n")
  verb = "Removed" if args.apply else "Would remove"
  for entry in entries:
    print(f"{verb}: {entry}")
  for entry in preserved:
    print(f"Preserved unexpected entry: {entry}")
  print(
    f"{verb} {len(entries)} entries; persistent homes and session directory preserved."
  )


if __name__ == "__main__":
  main()
