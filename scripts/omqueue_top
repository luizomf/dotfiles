#!/usr/bin/env bash

# Functional prototype for viewing recent Jobs and their latest artifacts.
# Keep as workflow evidence until a supported OMQueue interface replaces it.

# Uses the bounded Job-list operational view; no per-Job inspection is needed.

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omqueue_top [--limit <count>] [--state <state[,state...]>]
                   [--label <label>] [--job-id <job-id>] [-f]

Filters are exact and may be combined. --job-id uses direct Job inspection;
--limit has no effect when it is present.
EOF
}

limit=10
state=""
label=""
job_id=""
follow=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit)
      if [[ $# -lt 2 || ! "$2" =~ ^[1-9][0-9]*$ || "$2" -gt 200 ]]; then
        usage >&2
        exit 2
      fi
      limit="$2"
      shift 2
      ;;
    --state)
      if [[ $# -lt 2 || -z "$2" ]]; then
        usage >&2
        exit 2
      fi
      state="$2"
      shift 2
      ;;
    --label)
      if [[ $# -lt 2 || -z "$2" ]]; then
        usage >&2
        exit 2
      fi
      label="$2"
      shift 2
      ;;
    --job-id)
      if [[ $# -lt 2 || -z "$2" ]]; then
        usage >&2
        exit 2
      fi
      job_id="$2"
      shift 2
      ;;
    -f | --follow)
      follow=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -n "$job_id" && -n "$state" ]]; then
  valid_state='queued|running|retry_wait|succeeded|failed|cancel_requested|cancelled|unknown'
  if [[ ! "$state" =~ ^(${valid_state})(,(${valid_state}))*$ ]]; then
    printf 'omqueue_top: invalid Job state filter: %s\n' "$state" >&2
    exit 2
  fi
fi

fetch_jobs() {
  if [[ -z "$job_id" ]]; then
    local -a arguments=(job list --limit "$limit" --json)
    [[ -z "$state" ]] || arguments+=(--state "$state")
    [[ -z "$label" ]] || arguments+=(--label "$label")
    omqueue "${arguments[@]}"
    return
  fi

  omqueue job inspect "$job_id" --json |
    jq --arg state "$state" --arg label "$label" '
      .job as $inspection |
      $inspection.job as $job |
      ($inspection.attempts | max_by(.attemptNumber)) as $attempt |
      select(
        ($state == "" or ($state | split(",") | index($job.state))) and
        ($label == "" or $job.label == $label)
      ) |
      {
        jobs: [
          $job + {
            latestAttempt: (
              if $attempt == null then null
              else {
                attemptNumber: $attempt.attemptNumber,
                stdoutArtifactId: $attempt.output.stdout.artifactId,
                stderrArtifactId: $attempt.output.stderr.artifactId,
                resultArtifactId: $attempt.result.artifactId
              }
              end
            )
          }
        ]
      }
    '
}

render_jobs() {
  printf 'JOB ID\tNAME\tSTATE\tATTEMPT\tSTDOUT ARTIFACT\tSTDERR ARTIFACT\tRESULT ARTIFACT\n'

  fetch_jobs |
    jq -r '
      def bounded($width):
        if length > $width then .[0:($width - 3)] + "..." else . end;
      def name:
        if .label == null then "(unnamed)"
        else (.label | tojson | bounded(40))
        end;
      .jobs[] |
      .latestAttempt as $attempt |
      [
        .jobId,
        name,
        .state,
        ($attempt.attemptNumber // "-"),
        ($attempt.stdoutArtifactId // "-"),
        ($attempt.stderrArtifactId // "-"),
        ($attempt.resultArtifactId // "-")
      ] |
      @tsv
    '
}

if [[ "$follow" == false ]]; then
  render_jobs | column -t -s $'\t'
  exit 0
fi

while true; do
  snapshot="$(render_jobs | column -t -s $'\t')"
  printf '\033[H%s\n\033[J' "$snapshot"
  sleep 1
done
