#!/usr/bin/env bash

# Functional prototype for viewing recent Jobs and their latest artifacts.
# Keep as workflow evidence until a supported OMQueue interface replaces it.

set -euo pipefail

usage() {
  printf 'Usage: omqueue_top [--limit <count>] [-f]\n'
}

limit=10
follow=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit)
      if [[ $# -lt 2 || ! "$2" =~ ^[1-9][0-9]*$ || "$2" -gt 200 ]]; then
        usage >&2
        exit 2
      fi
      limit="$2"
      shift 2
      ;;
    -f | --follow)
      follow=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

render_jobs() {
  printf 'JOB ID\tSTATE\tATTEMPT\tSTDOUT ARTIFACT\tSTDERR ARTIFACT\tRESULT ARTIFACT\n'

  omqueue job list --limit "$limit" --json |
    jq -r '.jobs[] | [.jobId, .state] | @tsv' |
    while IFS=$'\t' read -r job_id state; do
      omqueue job inspect "$job_id" --json |
        jq -r --arg job_id "$job_id" --arg state "$state" '
          .job.attempts[-1] as $attempt |
          [
            $job_id,
            $state,
            ($attempt.attemptNumber // "-"),
            ($attempt.output.stdout.artifactId // "-"),
            ($attempt.output.stderr.artifactId // "-"),
            ($attempt.result.artifactId // "-")
          ] |
          @tsv
        '
    done
}

if [[ "$follow" == false ]]; then
  render_jobs | column -t -s $'\t'
  exit 0
fi

while true; do
  snapshot="$(render_jobs | column -t -s $'\t')"
  printf '\033[H%s\n\033[J' "$snapshot"
  sleep 1
done
