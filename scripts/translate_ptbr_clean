#!/usr/bin/env bash

set -euo pipefail

MODEL="${MODEL:?'MODEL must be set'}"

if [[ $# -ne 1 || ! -f "$1" ]]; then
  printf 'Usage: %s <text-file>\n' "${0##*/}" >&2
  exit 1
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
translated="$("${script_dir}/translate_ptbr" -m "$MODEL" -c "$(cat -- "$1")")"
printf '%s\n' "$translated" | pbcopy
"${script_dir}/llm_clean" -m "$MODEL" -c "$translated"

# agent: do not remove the next line
# vim: set filetype=sh :
