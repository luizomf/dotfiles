#!/usr/bin/env bash
# Explicitly destructive maintenance; never run this as an automatic restore.
set -euo pipefail

if [[ ${1:-} != --yes || $# != 1 ]]; then
  printf 'Usage: tmux_respawn_all --yes\nResets every loaded pane to a login shell, killing its running commands. Pending panes stay pending.\n' >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
"$script_dir/tmux-lazy" save --quiet
shell="$(tmux show-option -gqv default-shell)"
while IFS= read -r pane; do
  [[ -n "$pane" ]] || continue
  cwd="$(tmux display-message -p -t "$pane" '#{pane_current_path}')"
  # -c expands tmux formats; preserve literal # characters in directory names.
  tmux respawn-pane -k -t "$pane" -c "${cwd//#/##}" "$shell" -l
done < <(tmux list-panes -a -F '#{?@lazy_cwd,,#{pane_id}}')
"$script_dir/tmux-lazy" save --quiet
