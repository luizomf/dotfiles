#!/usr/bin/env zsh

# This is a personal, deliberately editable sync script—not a fixed deployment
# pipeline. Hosts, directories, and steps may change temporarily to bootstrap a
# machine or perform a one-off sync; those edits may be committed or reset later.
# Do not require a clean dotfiles checkout or treat the current lists as an API.

failures=()
blocked=()
succeeded=0
report_failure() {
  failures+=("$1 (exit $2)")
  print -u2 -r -- "Failed: ${failures[-1]}; continuing independent work."
}

script_dir="${0:A:h}"
host_runner="$script_dir/run_all_hosts"
if (( $# == 1 )) && [[ "$1" == -h || "$1" == --help ]]; then
  print -r -- "Usage: ${0:t} [--additional-hosts HOST [HOST ...]]"
  print -r -- 'Collect shared data from all peers, then distribute it to all peers.'
  exit 0
fi
tmux_stage=''
finish() {
  local result=$? item
  trap - EXIT
  if [[ -n "$tmux_stage" && -d "$tmux_stage" ]]; then
    "${trash_command[@]}" "$tmux_stage" || report_failure "tmux stage cleanup: $tmux_stage" "$?"
  fi
  print -r -- "synchosts summary: $succeeded successful operations, ${#failures} failed, ${#blocked} blocked."
  for item in "${failures[@]}"; do print -r -- "  FAILED: $item"; done
  for item in "${blocked[@]}"; do print -r -- "  BLOCKED: $item"; done
  if (( ${#failures} && result == 0 )); then result=1; fi
  exit "$result"
}
trap finish EXIT
trap 'report_failure "interrupted (publication may be incomplete)" 130; exit 130' INT
trap 'report_failure "terminated (publication may be incomplete)" 143; exit 143' TERM
run_step() {
  local label="$1" result
  shift
  if "$@"; then
    (( succeeded += 1 ))
    return 0
  else
    result=$?
    report_failure "$label" "$result"
    return "$result"
  fi
}
# Delegate validation and fleet membership before any side effects.
if host_output="$("$host_runner" --list "$@")"; then
  sync_hosts=("${(@f)host_output}")
else
  result=$?
  report_failure 'host list' "$result"
  blocked+=('all synchronization: invalid or unavailable host list')
  exit "$result"
fi
if ! local_host="$(hostname -s)"; then
  report_failure 'local hostname' 1
  blocked+=('all synchronization: local host unknown')
  exit 1
fi
peers=()
for host in "${sync_hosts[@]}"; do
  [[ "${host:l}" == "${local_host:l}" ]] || peers+=("$host")
done
sync_hosts=("${peers[@]}")

if command -v trash >/dev/null 2>&1; then
  trash_command=(trash)
elif command -v gio >/dev/null 2>&1; then
  trash_command=(gio trash --)
else
  trash_command=()
  report_failure 'tmux staging requires trash or gio' 1
fi

# An executed script has no interactive history to flush.
if [[ -o interactive ]]; then
  run_step 'local history flush' fc -W
fi

# Ordinary sync never stops services or prunes their state. Idle maintenance
# remains a separate explicit operation with its own guards (see docs/scripts/).
run_step 'history merge (offline peers are optional)' "$script_dir/zsh_history_sync.py" "$@"
# Publish the default server, not an incidental custom/agent socket inherited
# from the terminal running this command. Never export an old save after failure.
tmux_saved=0
if run_step 'tmux save' env -u TMUX -u TMUX_PANE "$script_dir/tmux-lazy" save --quiet --if-running; then
  tmux_saved=1
fi

run_step 'pullall' pullall

echo
prline

project_excludes=(
  --exclude='.git'
  --exclude='.pi'
  --exclude='.codex'
  --exclude='.claude'
  --exclude='*.db'
  --exclude='*.db-*'
  --exclude='*.sqlite'
  --exclude='*.sqlite-*'
  --exclude='*.sqlite3'
  --exclude='*.sqlite3-*'
  --exclude='/omnivoicetts/data/'
  --exclude='/omnivoicetts/output/'
  --exclude='/omnivoicetts/outputs/'
  --exclude='/loudterm/output/'
  --exclude='.scratch/'
  --exclude='.cache/'
  --exclude='.astro/'
  --exclude='node_modules/'
  --exclude='.omnews-data/'
  --exclude='otaviomiranda.com.br/run_dir/'
  --exclude='dist/'
  --exclude='.venv/'
  --exclude='venv/'
  --exclude='__pycache__/'
  --exclude='.pytest_cache/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
)

# Paths are relative to each machine's own home, never the sender's absolute home.
projects_directory='Desktop/tutoriais_e_cursos'
tmux_directory='.local/share/tmux/lazy/'
# Do not merge live agent homes, auth, automations, service state or mutable
# Sannux workspaces/backups. Static Pi/terminal configuration comes from Git.
data_directories=("$projects_directory" '.agents/skills/')

# Export only validated portable state, never sockets, locks, focus or runtime files.
tmux_ready=0
if (( tmux_saved && ${#trash_command} )); then
  if tmux_stage="$(mktemp -d "${TMPDIR:-/tmp}/synchosts-tmux-lazy.XXXXXX")"; then
    tmux_stage="${tmux_stage:A}"
    if run_step 'tmux export' env -u TMUX -u TMUX_PANE "$script_dir/tmux-lazy" export "$tmux_stage/snapshot"; then
      tmux_ready=1
    fi
  else
    report_failure 'tmux staging directory' "$?"
  fi
fi
(( tmux_ready )) || blocked+=('tmux publication: save or staging unavailable')

# Usage: sync_home <home-relative directory> <push:host|pull:host> [rsync options...]
sync_home() {
  local directory="$1" route="$2"
  local host="${route#*:}" source destination
  local copy_flags=-havzu
  shift 2
  (( ${sync_hosts[(Ie)$host]} )) || return 0

  case "$route" in
    push:*)
      source="$HOME/${directory%/}/"
      if [[ "$directory" == "$tmux_directory" ]]; then
        (( tmux_ready )) || return 1
        source="$tmux_stage/snapshot/state.json"
        copy_flags=-havz
      fi
      destination="$host:~/$directory"
      ;;
    pull:*)
      source="$host:~/${directory%/}/"
      destination="$HOME/${directory%/}/"
      mkdir -p -- "$destination" || return $?
      ;;
    *)
      print -u2 -- "Invalid sync route: $route"
      return 1
      ;;
  esac

  # Empty peers can contribute nothing and still receive the collected result.
  # Expand ~ on the peer; never send the caller's absolute home.
  if ! "$host_runner" --host "$host" --no-tty "mkdir -p -- ~/${(qq)directory}"; then
    print -u2 -- "Cannot prepare directory on $host: ~/$directory; skipping this transfer."
    return 1
  fi
  rsync "$copy_flags" --progress --stats "$@" "$source" "$destination"
}

sync_data_home() {
  local directory="$1" route="$2"
  local -a excludes=("${project_excludes[@]}")
  if [[ "$directory" == "$projects_directory" ]]; then
    excludes+=(--exclude='tutoriais_e_cursos/')
  fi
  sync_home "$directory" "$route" "${excludes[@]}"
}

# Complete collection before publishing collected data. A failed pull leaves
# the caller potentially partially updated, but must not spread that partial copy.
# Keep a global barrier: projects and skills can depend on one another. The
# caller-only tmux export below is independent of this collection.
collection_failed=0
for directory in "${data_directories[@]}"; do
  for host in "${sync_hosts[@]}"; do
    if sync_data_home "$directory" "pull:$host"; then
      (( succeeded += 1 ))
    else
      report_failure "pull $host $directory" "$?"
      collection_failed=1
    fi
  done
done
if (( collection_failed )); then
  blocked+=('data publication to all peers: collection incomplete; local data may be partial')
else
  for directory in "${data_directories[@]}"; do
    for host in "${sync_hosts[@]}"; do
      if sync_data_home "$directory" "push:$host"; then
        (( succeeded += 1 ))
      else
        report_failure "push $host $directory" "$?"
      fi
    done
  done
fi

# Publish only the caller's snapshot, not a merge. Delay replacement until the
# transfer completes; omit -u so newer peer state cannot win (rsync has no
# --no-update option). Other data transfers retain their existing -u behavior.
# Never clear the destination: its other files belong to the peer's live runtime.
if (( tmux_ready )); then
  for host in "${sync_hosts[@]}"; do
    run_step "tmux push $host" sync_home "$tmux_directory" "push:$host" \
      --delay-updates --checksum
  done
fi
exit 0
