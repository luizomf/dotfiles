#!/usr/bin/env zsh

# This is a personal, deliberately editable sync script—not a fixed deployment
# pipeline. Hosts, directories, and steps may change temporarily to bootstrap a
# machine or perform a one-off sync; those edits may be committed or reset later.
# Do not require a clean dotfiles checkout or treat the current lists as an API.

script_dir="${0:A:h}"
host_runner="$script_dir/run_all_hosts"
if (( $# == 1 )) && [[ "$1" == -h || "$1" == --help ]]; then
  print -r -- "Usage: ${0:t} [--additional-hosts HOST [HOST ...]]"
  print -r -- 'Collect shared data from all peers, then distribute it to all peers.'
  exit 0
fi
# Delegate validation and fleet membership before any side effects.
host_output="$("$host_runner" --list "$@")" || exit $?
sync_hosts=("${(@f)host_output}")
local_host="$(hostname -s)" || exit $?
peers=()
for host in "${sync_hosts[@]}"; do
  [[ "${host:l}" == "${local_host:l}" ]] || peers+=("$host")
done
sync_hosts=("${peers[@]}")

if command -v trash >/dev/null 2>&1; then
  trash_command=(trash)
elif command -v gio >/dev/null 2>&1; then
  trash_command=(gio trash --)
else
  print -u2 -- 'trash or gio is required; no synchronization was started.'
  exit 1
fi

# An executed script has no interactive history to flush.
if [[ -o interactive ]]; then
  fc -W || exit $?
fi

# Manual idle maintenance only. Refuse live agent-home consumers before stops
# or synchronization. All peers need the updated helper before this is used.
"$host_runner" "$@" -- '"$HOME/dotfiles/scripts/clear_sannux_transients"' || exit $?

# Daily is optional on each host. Hosts without its checkout have nothing to prune.
daily_maintenance='daily_script="${PROJECTS_DIR:-$HOME/Desktop/tutoriais_e_cursos}/daily-paper/maintenance/prune-runtime-history.sh"; if [[ -x "$daily_script" ]]; then "$daily_script"'
"$host_runner" "$@" -- "$daily_maintenance --tts-media-check; fi" || exit $?

"$script_dir/zsh_history_sync.py" "$@" || exit $?
# Publish the default server, not an incidental custom/agent socket inherited
# from the terminal running this maintenance command.
env -u TMUX -u TMUX_PANE "$script_dir/tmux-lazy" save --quiet --if-running || exit $?

"$host_runner" "$@" -- '"$HOME/dotfiles/scripts/stop_omnivoicetts"' || exit $?
"$host_runner" "$@" -- "$daily_maintenance --tts-media-preview; fi" || exit $?
"$host_runner" "$@" -- "$daily_maintenance --tts-media-apply; fi" || exit $?
"$host_runner" "$@" -- '"$HOME/dotfiles/scripts/clear_sannux_transients" --apply --idle-confirmed' || exit $?

if ! pullall; then
  print -u2 -- 'Some repositories could not be updated; continuing synchronization.'
fi

echo
prline

project_excludes=(
  --exclude='.scratch/'
  --exclude='.cache/'
  --exclude='.astro/'
  --exclude='node_modules/'
  --exclude='.omnews-data/'
  --exclude='otaviomiranda.com.br/run_dir/'
  --exclude='dist/'
  --exclude='.venv/'
  --exclude='venv/'
  --exclude='__pycache__/'
  --exclude='.pytest_cache/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
)

# Paths are relative to each machine's own home, never the sender's absolute home.
projects_directory='Desktop/tutoriais_e_cursos'
tmux_directory='.local/share/tmux/lazy/'
pi_directory='.pi/'
shared_directories=(
  'sannux-data/'
  '.agents/'
  '.ollama/service/'
  '.config/omxterm/'
  '.codex/automations/'
)

data_directories=("$projects_directory" "$pi_directory" "${shared_directories[@]}")

# Export only validated portable state, never sockets, locks, focus or runtime files.
tmux_stage="$(mktemp -d "${TMPDIR:-/tmp}/synchosts-tmux-lazy.XXXXXX")" || exit 1
tmux_stage="${tmux_stage:A}"
cleanup_stage() {
  local result=$?
  trap - EXIT
  if [[ -d "$tmux_stage" ]] && ! "${trash_command[@]}" "$tmux_stage"; then
    print -u2 -- "Cannot move staged tmux snapshot to Trash: $tmux_stage"
    (( result != 0 )) || result=1
  fi
  exit "$result"
}
trap cleanup_stage EXIT
tmux_ready=0
if env -u TMUX -u TMUX_PANE "$script_dir/tmux-lazy" export "$tmux_stage/snapshot"; then
  tmux_ready=1
else
  print -u2 -- 'Cannot prepare tmux snapshot; skipping tmux transfers.'
fi

# Usage: sync_home <home-relative directory> <push:host|pull:host> [rsync options...]
sync_home() {
  local directory="$1" route="$2"
  local host="${route#*:}" source destination
  local copy_flags=-havzu
  shift 2
  (( ${sync_hosts[(Ie)$host]} )) || return 0

  case "$route" in
    push:*)
      source="$HOME/${directory%/}/"
      if [[ "$directory" == "$tmux_directory" ]]; then
        (( tmux_ready )) || return 1
        source="$tmux_stage/snapshot/state.json"
        copy_flags=-havz
      fi
      destination="$host:~/$directory"
      ;;
    pull:*)
      source="$host:~/${directory%/}/"
      destination="$HOME/${directory%/}/"
      mkdir -p -- "$destination" || return $?
      ;;
    *)
      print -u2 -- "Invalid sync route: $route"
      return 1
      ;;
  esac

  # Empty peers can contribute nothing and still receive the collected result.
  # Expand ~ on the peer; never send the caller's absolute home.
  if ! "$host_runner" --host "$host" --no-tty "mkdir -p -- ~/${(qq)directory}"; then
    print -u2 -- "Cannot prepare directory on $host: ~/$directory; stopping synchronization."
    return 1
  fi
  rsync "$copy_flags" --progress --stats "$@" "$source" "$destination"
}

sync_data_home() {
  local directory="$1" route="$2"
  local -a excludes=("${project_excludes[@]}")
  if [[ "$directory" == "$projects_directory" ]]; then
    excludes+=(--exclude='tutoriais_e_cursos/')
  elif [[ "$directory" == "$pi_directory" ]]; then
    excludes+=(--exclude='agent/extensions/**/node_modules/'
      --exclude='/agent/sessions/')
  elif [[ "$directory" == 'sannux-data/' ]]; then
    excludes+=(--exclude='/agent-homes/*.ephemeral-runs/'
      --exclude='/agent-homes/pi-daily-paper-sessions/'
      --exclude='/agent-homes/*/.pi-resources.*/'
      --exclude='/agent-homes/*/.pi/agent/sessions/'
      --exclude='/agent-homes/*/.codex/sessions/'
      --exclude='/agent-homes/*/.codex/archived_sessions/'
      --exclude='/workspaces/pi-daily-paper-node-modules/')
  elif [[ "$directory" == '.codex/automations/' ]]; then
    excludes+=(--exclude='/*/hooks/state/'
      --exclude='/*/hooks/on-end/tts/*.json')
  fi
  sync_home "$directory" "$route" "${excludes[@]}"
}

# Complete collection before publishing any data. A failed pull leaves the
# caller potentially partially updated, but must not spread that partial copy.
for direction in pull push; do
  for directory in "${data_directories[@]}"; do
    for host in "${sync_hosts[@]}"; do
      sync_data_home "$directory" "$direction:$host" || exit $?
    done
  done
done

# Publish only the caller's snapshot, not a merge. Delay replacement until the
# transfer completes; omit -u so newer peer state cannot win (rsync has no
# --no-update option). Other data transfers retain their existing -u behavior.
# Never clear the destination: its other files belong to the peer's live runtime.
if (( tmux_ready )); then
  for host in "${sync_hosts[@]}"; do
    sync_home "$tmux_directory" "push:$host" \
      --delay-updates --checksum || exit $?
  done
else
  exit 1
fi
