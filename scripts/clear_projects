#!/usr/bin/env bash

# DESTRUCTIVE CLEANUP: permanently delete disposable scratch/build artifacts so
# large leftovers do not consume disk space or get copied during host sync.
# Scope: ONLY the contents of .scratch and release in immediate, non-hidden
# projects under PROJECTS_DIR, plus $HOME/dotfiles. Preserve those directories
# and other project files. Also prune unused local Docker build cache to 5 GB.
# Their names are an explicit disposal policy:
# this script cannot tell whether work is finished or a release was published.
#
# There is no trash, confirmation, or undo. Inspect --dry-run before deletion.
# Root validation, symlink checks, quoted arrays, and hidden/empty glob handling
# are safety requirements, not optional cleanup. Do not broaden the targets or
# replace the selection with loose rm globs. set -e and the ERR trap do NOT
# protect against deleting a valid but unintended path.
# Stop concurrent writers first; path checks do not prevent filesystem races
# or protect mounted trees inside the targets. Never validate changes by running
# cleanup against real projects: use tests/test_clear_projects.py and its
# temporary fixtures. Keep the pre-commit regression gate intact.
# See docs/clear_projects.md for the contract and remaining limitations.

set -Eeuo pipefail

trap 'printf "Error: line %s, status %s: %s\n" "$LINENO" "$?" "$BASH_COMMAND" >&2' ERR

clean_docker_cache() {
  if [[ "$1" == true ]]; then
    printf 'Would prune unused local Docker build cache toward 5 GB.\n'
    return
  fi
  command -v docker >/dev/null || { printf 'Skipping Docker: not installed.\n'; return; }
  local endpoint help
  local -a docker_command=(env -u DOCKER_HOST -u DOCKER_CONTEXT -u BUILDX_BUILDER docker --context default)
  if ! endpoint=$("${docker_command[@]}" context inspect default --format '{{.Endpoints.docker.Host}}') ||
    [[ $endpoint != unix:///* ]]; then
    printf 'Skipping Docker: default endpoint is not a verified local Unix socket.\n'
    return
  fi
  if ! "${docker_command[@]}" info >/dev/null 2>&1; then
    printf 'Skipping Docker: local daemon unavailable to this user.\n'
    return
  fi
  if ! help=$("${docker_command[@]}" buildx prune --help 2>/dev/null) ||
    [[ $help != *--max-used-space* ]]; then
    printf 'Skipping Docker: Buildx lacks bounded cache cleanup.\n'
    return
  fi
  if ! "${docker_command[@]}" buildx prune --builder default --all --force --max-used-space 5GB; then
    printf 'Warning: Docker build cache cleanup failed.\n' >&2
  fi
}

is_dir() {
  local dir_path="${1:?Directory path is required}"
  [[ -d "$dir_path" && ! -L "$dir_path" ]]
}

require_dir() {
  if ! is_dir "$1"; then
    printf 'Not a directory, or is a symlink: %s\n' "$1" >&2
    return 1
  fi
}

clear_contents() {
  local target="${1:?Target is required}"
  local dry_run="$2"
  local entry
  local -a entries

  is_dir "$target" || return 0
  entries=("$target"/*)
  # Bash 3.2 treats an empty array expansion as unset under nounset.
  if [[ "${#entries[@]}" -eq 0 ]]; then
    return 0
  fi
  for entry in "${entries[@]}"; do
    if [[ "$dry_run" == true ]]; then
      printf 'Would remove: %q\n' "$entry"
    else
      printf 'Removing: %q\n' "$entry"
      command rm -rf -- "$entry"
    fi
  done
}

main() {
  local dry_run=false
  case "${1-}" in
    --dry-run) dry_run=true ;;
    -h|--help)
      printf 'Usage: clear_projects [--dry-run]\n\nRemove all contents of .scratch and release in immediate projects\nand ~/dotfiles. Preserve the directories themselves.\nAlso prune unused local Docker build cache toward 5 GB.\n'
      return 0
      ;;
    '') ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; return 1 ;;
  esac
  if [[ "$#" -gt 1 ]]; then
    printf 'Expected at most one argument\n' >&2
    return 1
  fi

  local home="${HOME:?HOME is unset or empty}"
  local projects_root="${PROJECTS_DIR:?PROJECTS_DIR is unset or empty}"
  local project subdir candidate
  local -a projects
  local -a subdirs=(.scratch release)

  # Strip trailing slashes so -L can detect a symlink at the root itself.
  while [[ "$projects_root" != / && "$projects_root" == */ ]]; do
    projects_root="${projects_root%/}"
  done
  require_dir "$projects_root"
  require_dir "$home"
  projects_root="$(cd -P -- "$projects_root" && pwd -P)"
  home="$(cd -P -- "$home" && pwd -P)"
  if [[ "$projects_root" == / || "$projects_root" == "$home" ]]; then
    printf 'Refusing unsafe projects root: %s\n' "$projects_root" >&2
    return 1
  fi

  # Match hidden contents too, but never . or ..; unmatched globs disappear.
  # Keep hidden projects out of the project list.
  unset GLOBIGNORE
  shopt -s nullglob
  shopt -u dotglob
  projects=("$projects_root"/* "$home/dotfiles")
  shopt -s dotglob

  for project in "${projects[@]}"; do
    is_dir "$project" || continue
    for subdir in "${subdirs[@]}"; do
      candidate="$project/$subdir"
      clear_contents "$candidate" "$dry_run"
    done
  done
  clean_docker_cache "$dry_run"
}

main "$@"
