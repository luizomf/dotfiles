#!/usr/bin/env bash

set -Eeuo pipefail

_error_msg=

check() {
  local status=$?
  [[ $status -eq 0 ]] && return 0
  logerror "$_error_msg ($(basename "${BASH_SOURCE[1]}"):${BASH_LINENO[0]}, exit=$status)" >&2
}

trap 'check' ERR

is_positive() {
  local n="${1:-}"
  _error_msg="Not a positive number: $n"
  [[ "$n" =~ ^\+?[0-9]+$ ]]
}

_window_name="tmp"

if (($# > 0)); then
  _window_name="${1:-new}"
  shift
fi

_session_name="$(tmux display-message -p "#{session_name}")"
_window_dir="${_window_dir:-$(pwd)}"
tmux neww -t "$_session_name" -c "$_window_dir" -n "$_window_name" -a "$@"
