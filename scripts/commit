#!/usr/bin/env bash

set -euo pipefail

MODEL="${MODEL:?Variable MODEL not found}"
MODEL_REASONING="${LOCAL_MODEL_REASONING:?Variable LOCAL_MODEL_REASONING not found}"

declare PROMPT
PROMPT="Verify the modified files in the current directory using Git. "
PROMPT+="Create organized and well-documented commit messages, following the "
PROMPT+="*Conventional Commits* standard, and commit the files with clear, concise messages. "
PROMPT+="DO NOT BROWSE OTHER FILES OR COMMITS; YOUR ONLY TASK IS TO PROVIDE A CONCISE MESSAGE "
PROMPT+="FOR THE MODIFIED FILES. "
PROMPT+="Use the message body for longer text if necessary. The language must be English. "
PROMPT+="Do not alter, edit, or delete files. Your only task is to document what was done and "
PROMPT+="commit the changes. Be careful when including bash or zsh commands in the messages and "
PROMPT+="bash/zsh expansion. "

title "Commit: ${MODEL} ${MODEL_REASONING}"

printf '%s\n' "$PROMPT" \
  | sannux_ephemeral pi --model "ollama/${MODEL}:${MODEL_REASONING}" --no-session -p "$@"

title "Commit done: ${MODEL} ${MODEL_REASONING}"
