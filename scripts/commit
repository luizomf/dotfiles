#!/usr/bin/env bash

set -euo pipefail

MODEL="${MODEL:?'Variable $MODEL not found'}"
MODEL_REASONING="${LOCAL_MODEL_REASONING:?'Variable $LOCAL_MODEL_REASONING not found'}"

declare PROMPT
PROMPT="Verify the modified files in the current directory using Git. "
PROMPT+="Create organized and well-documented commit messages, using the " 
PROMPT+="conventional commit style, and commit the files with clear commit messages. " 
PROMPT+="Use the message body for longer messages, if necessary. The language is English. " 
PROMPT+="Do not touch, edit, or delete files. Your only task is to document what was done "
PROMPT+="and confirm the changes. Be careful about expanding bash and zsh commands in your messages."

# printf "%b" "${PROMPT}\n" | sannux_ephemeral pi --model "${MODEL}" -c model_reasoning_effort="${MODEL_REASONING}" exec --ephemeral --yolo "${@:-}
printf "%b" "${PROMPT}\n" | sannux_ephemeral pi --model "ollama/${MODEL}:${MODEL_REASONING}" --no-session -p "${@:-}"

