#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -n "${OM_PATHS_FILE:-}" || -z "${PROJECTS_DIR:-}" ]]; then
  # shellcheck source=/dev/null
  source "${OM_PATHS_FILE:-${script_dir}/../config/paths.sh}"
fi
export PROJECTS_DIR
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export PIP_NO_INDEX=1
export UV_OFFLINE=1
export UV_NO_SYNC=1

# The downloaded models:
# k2-fsa/OmniVoice - fp32 - original (heavily tested)
# drbaph/OmniVoice-bf16 - bf16
export OMNIVOICE_MODEL='drbaph/OmniVoice-bf16'

(
cd "${PROJECTS_DIR}/omnivoicetts" || exit 1
# ./scripts/clear_cache
pkill -9 -f '[o]mnivoicetts' || true
cat | ./scripts/male-pt \
  --offline --player auto --model "${OMNIVOICE_MODEL}" \
  --num-step 24 --guidance-scale 1 --t-shift 0.1 \
  --class-temperature 0.0 --position-temperature 4.0 --layer-penalty-factor 5.0 \
  --chunk-len 80 --prebuffer-chunks 2 --sliding-window-chunks 2 \
  --inter-chunk-silence-ms 100 --chunking kokoro \
  --split-on-newlines True --ensure-terminal-punctuation True \
  --speed 1.0 --model-fade-ms 100 --model-pad-ms 250 \
  --denoise False --preprocess-prompt True --postprocess-output False \
  --chunk-cache-dir .cache/omnivoice-play/male-pt-br \
  --ref-audio samples/male-pt-br.wav --language pt \
  --instruct "male, middle-aged, moderate pitch, portuguese accent" \
  "$@" > /dev/null &
)

