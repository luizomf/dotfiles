#!/usr/bin/env zsh

# Public defaults for every Zsh, including non-interactive SSH commands.
# Keep private ~/.env files and credential lookups in the interactive loader.
. "$HOME/dotfiles/config/paths.sh"

# Zsh does not read /etc/profile. Supply a UTF-8 default for bare sessions,
# including SSH commands, but preserve explicit locale choices (even C).
# Never set LC_ALL: callers must remain able to override individual categories.
if [[ -z ${LANG:-} && -z ${LC_ALL:-} && -z ${LC_CTYPE:-} ]]; then
  () {
    local candidate
    local -a available

    available=("${(@f)$(locale -a 2>/dev/null)}")

    for candidate in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
      if (( ${available[(Ie)$candidate]} )); then
        export LANG=$candidate
        break
      fi
    done
  }
fi

export OLLAMA_HOST="${OLLAMA_HOST:-192.168.0.109:11434}"
export OLLAMA_TIMEOUT_MS="${OLLAMA_TIMEOUT_MS:-10000}"
export OLLAMA_LOAD_TIMEOUT="${OLLAMA_LOAD_TIMEOUT:-10m}"
export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-10m}"
export LOCAL_MODEL="${LOCAL_MODEL:-qwen3.8:27b-mlx}"
export LOCAL_MODEL_REASONING="${LOCAL_MODEL_REASONING:-high}"
# Preserve the existing contract: MODEL follows LOCAL_MODEL.
export MODEL="${LOCAL_MODEL}"
