ZSH_CONFIG_DIR="$HOME/dotfiles/zsh/config"

CONFIG_CONFIG_FILE="${ZSH_CONFIG_DIR}/config"
FUNCTIONS_CONFIG_FILE="${ZSH_CONFIG_DIR}/functions"
EXPORTS_CONFIG_FILE="${ZSH_CONFIG_DIR}/exports"
ALIASES_CONFIG_FILE="${ZSH_CONFIG_DIR}/aliases"
KEYBINDS_CONFIG_FILE="${ZSH_CONFIG_DIR}/keybinds"

ZSH_CONFIG_FILES=(
  "$CONFIG_CONFIG_FILE"
  "$FUNCTIONS_CONFIG_FILE" 
  "$EXPORTS_CONFIG_FILE"
  "$ALIASES_CONFIG_FILE" 
  "$KEYBINDS_CONFIG_FILE"
)

for f in "${ZSH_CONFIG_FILES[@]}"; do
  if test -f "$f"; then
    # shellcheck disable=SC1090
    source "$f"
  else
    printf "%s" "404: $f not found.\n"
  fi
done

if [[ -f "${HOME}"/dotfiles/scripts/title ]]; then
  if [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]]; then
    # A busy restore must not hold the prompt waiting for a tmux title reply.
    # Manual invocations of scripts/title remain synchronous and report errors.
    ("${HOME}"/dotfiles/scripts/title "${${PWD:t}:-/}" </dev/null >/dev/null 2>&1) &!
  else
    "${HOME}"/dotfiles/scripts/title "${${PWD:t}:-/}"
  fi
fi
