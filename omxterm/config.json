{
  "version": 1,
  "language": "en-US",
  "confirmClose": true,
  "logLevel": "info",
  "windowsShell": "C:\\Program Files\\Git\\bin\\bash.exe",
  "font": {
    "family": "FiraCode Nerd Font",
    "size": 27,
    "lineHeight": 1,
    "ligatures": false
  },
  "terminal": {
    "padding": {
      "top": 16,
      "right": 16,
      "bottom": 4,
      "left": 16
    }
  },
  "scrollback": {
    "lines": 30000
  },
  "keyboard": {
    "optionAsAlt": "left"
  },
  "window": {
    "alwaysOnTop": false,
    "blur": true,
    "transparency": 0.2,
    "showTabBar": true,
    "showTitleBar": false,
    "auxiliaryPanelSide": "right"
  },
  "keybinds": {
    "quit": "Command+Q",
    "copy": "Command+C",
    "paste": "Command+V",
    "selectAll": "Command+A",
    "find": "Command+F",
    "newWindow": "Command+N",
    "closeWindow": "Command+Shift+W",
    "newTab": "Command+T",
    "closeTab": "Command+W",
    "nextTab": "Command+Shift+L",
    "previousTab": "Command+Shift+H",
    "selectTab1": "Command+1",
    "selectTab2": "Command+2",
    "selectTab3": "Command+3",
    "selectTab4": "Command+4",
    "selectTab5": "Command+5",
    "selectTab6": "Command+6",
    "selectTab7": "Command+7",
    "selectTab8": "Command+8",
    "selectTab9": "Command+9",
    "splitRight": "Command+D",
    "splitDown": "Command+Shift+E",
    "focusNextPane": "Command+]",
    "focusPreviousPane": "Command+[",
    "focusPaneLeft": "Command+Control+H",
    "focusPaneRight": "Command+Control+L",
    "focusPaneUp": "Command+Control+K",
    "focusPaneDown": "Command+Control+J",
    "equalizePanes": "Command+Control+=",
    "zoomIn": "Command+Shift+=",
    "zoomOut": "Command+Shift+-",
    "actualSize": "Command+Shift+0",
    "toggleFullScreen": "Command+Enter",
    "toggleSnippets": "Command+Shift+S",
    "toggleTabBar": "Command+Shift+B",
    "toggleTitleBar": "Command+Shift+D",
    "reloadConfig": "Command+Shift+,",
    "closePane": "Command+Control+W",
    "toggleFiles": "Command+Control+F",
    "toggleSshConnect": "Command+Control+O",
    "toggleAuxiliaryPanel": null,
    "commandPalette": "Command+Shift+P"
  }
}
