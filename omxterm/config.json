{
  "version": 1,
  "language": "en-US",
  "confirmClose": true,
  "logLevel": "info",
  "windowsShell": "C:\\Program Files\\Git\\bin\\bash.exe",
  "font": {
    "family": "FiraCode Nerd Font",
    "size": 27,
    "lineHeight": 1,
    "ligatures": false
  },
  "terminal": {
    "padding": {
      "top": 16,
      "right": 16,
      "bottom": 4,
      "left": 16
    }
  },
  "scrollback": {
    "lines": 30000
  },
  "keyboard": {
    "optionAsAlt": "none"
  },
  "window": {
    "alwaysOnTop": false,
    "blur": true,
    "transparency": 0.2,
    "showTabBar": true,
    "showTitleBar": false
  },
  "theme": {
    "path": "./themes/omtheme.json"
  },
  "keybinds": {
    "quit": "CommandOrControl+Q",
    "copy": "CommandOrControl+C",
    "paste": "CommandOrControl+V",
    "selectAll": "CommandOrControl+A",
    "find": "CommandOrControl+F",
    "newWindow": "CommandOrControl+N",
    "closeWindow": "CommandOrControl+Shift+W",
    "newTab": "CommandOrControl+T",
    "closeTab": "CommandOrControl+W",
    "nextTab": "CommandOrControl+Shift+L",
    "previousTab": "CommandOrControl+Shift+H",
    "selectTab1": "CommandOrControl+1",
    "selectTab2": "CommandOrControl+2",
    "selectTab3": "CommandOrControl+3",
    "selectTab4": "CommandOrControl+4",
    "selectTab5": "CommandOrControl+5",
    "selectTab6": "CommandOrControl+6",
    "selectTab7": "CommandOrControl+7",
    "selectTab8": "CommandOrControl+8",
    "selectTab9": "CommandOrControl+9",
    "splitRight": "CommandOrControl+D",
    "splitDown": "CommandOrControl+Shift+E",
    "closePane": "CommandOrControl+Alt+W",
    "focusNextPane": "CommandOrControl+]",
    "focusPreviousPane": "CommandOrControl+[",
    "focusPaneLeft": "CommandOrControl+Alt+Left",
    "focusPaneRight": "CommandOrControl+Alt+Right",
    "focusPaneUp": "CommandOrControl+Alt+Up",
    "focusPaneDown": "CommandOrControl+Alt+Down",
    "equalizePanes": "Command+Control+=",
    "zoomIn": "CommandOrControl+Plus",
    "zoomOut": "CommandOrControl+-",
    "actualSize": "CommandOrControl+0",
    "toggleFullScreen": "CommandOrControl+Enter",
    "toggleSnippets": "CommandOrControl+Shift+S",
    "toggleTabBar": "CommandOrControl+Shift+B",
    "toggleTitleBar": "CommandOrControl+Shift+D",
    "reloadConfig": "CommandOrControl+Shift+,"
  }
}
